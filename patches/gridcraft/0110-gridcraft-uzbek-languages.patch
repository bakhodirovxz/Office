From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Sat, 17 Oct 2026 23:57:52 +0500
Subject: [PATCH] ui-egui: office overlay adds uz-latn and uz-cyrl when its catalogs are present

Adds uz-latn (Oʻzbekcha) and uz-cyrl (Ўзбекча) to Language when the overlay supplies their
catalogs. build_office.rs looks for catalog-uz-latn.tsv and catalog-uz-cyrl.tsv (written by
`cargo xt i18n export`, fallback chain already applied) next to overlay.env; when both exist the
build gets cfg(office_uz) and each catalog is compiled into a `match` function shaped like the
tables in src/i18n/*.rs. Two cfg'd variants (serde names uz-latn and uz-cyrl), their arms in
name(), code() and tr(), and an early `uz` branch in from_tag() that picks Cyrillic for
`uz-Cyrl-*` and `uz_UZ@cyrillic` and Latin otherwise (OS locale and browser language). The picker
name carries the export's draft marker while Uzbek rows are unreviewed. Without the catalogs
Language, its tests and the language list are upstream's.
---
 crates/ui-egui/build_office.rs             | 57 +++++++++++++++++++++++++++++-
 crates/ui-egui/src/i18n.rs                 | 41 ++++++++++++++++++++-
 crates/ui-egui/src/office_overlay_tests.rs | 18 ++++++++++
 3 files changed, 114 insertions(+), 2 deletions(-)

diff --git a/crates/ui-egui/build_office.rs b/crates/ui-egui/build_office.rs
index c50531e..295640e 100644
--- a/crates/ui-egui/build_office.rs
+++ b/crates/ui-egui/build_office.rs
@@ -95,9 +95,64 @@ fn generate(dir: &Path) -> String {
         let _ = write!(list, "({key:?}, include_bytes!({:?}) as &[u8]), ", include_path(dir, f));
     }
     let _ = writeln!(o, "pub static FALLBACK_FONTS: &[(&str, &[u8])] = &[{list}];");
+    o + &uzbek(Some(dir))
+}
+
+/// The Uzbek catalogs that `cargo xt i18n export` wrote next to `overlay.env` (`key<TAB>translation` lines). Only when both
+/// are there does the build get `cfg(office_uz)`, which adds uz-latn and uz-cyrl to `Language`. Each catalog becomes a
+/// `match` function shaped like the ones in `src/i18n/*.rs`.
+fn uzbek(dir: Option<&Path>) -> String {
+    println!("cargo::rustc-check-cfg=cfg(office_uz)");
+    let files = dir.map(|d| [d.join("catalog-uz-latn.tsv"), d.join("catalog-uz-cyrl.tsv")]).filter(|f| f.iter().all(|p| p.is_file()));
+    let mut o = String::new();
+    let Some(files) = files else {
+        let _ = writeln!(o, "pub const EXTRA_LANGS: usize = 0;");
+        let _ = writeln!(o, "pub const NAME_UZ_LATN: &str = \"\";\npub const NAME_UZ_CYRL: &str = \"\";");
+        return o;
+    };
+    println!("cargo::rustc-cfg=office_uz");
+    let meta = dir.map(|d| d.join("catalog-meta.env")).unwrap_or_default();
+    println!("cargo::rerun-if-changed={}", meta.display());
+    let meta: HashMap<String, String> = std::fs::read_to_string(&meta)
+        .unwrap_or_default()
+        .lines()
+        .filter_map(|l| l.split_once('='))
+        .map(|(k, v)| (k.to_string(), v.trim().to_string()))
+        .collect();
+    let _ = writeln!(o, "pub const EXTRA_LANGS: usize = 2;");
+    for ((key, name), file) in [("LATN", "O\u{2bb}zbekcha"), ("CYRL", "Ўзбекча")].into_iter().zip(files) {
+        println!("cargo::rerun-if-changed={}", file.display());
+        let _ = writeln!(o, "pub const NAME_UZ_{key}: &str = {:?};", meta.get(&format!("NAME_UZ_{key}")).map_or(name, String::as_str));
+        let _ = writeln!(o, "pub fn translate_uz_{}(text: &str) -> Option<&'static str> {{\n    Some(match text {{", key.to_lowercase());
+        for line in std::fs::read_to_string(&file).unwrap_or_default().lines().filter(|l| !l.starts_with('#')) {
+            if let Some((k, v)) = line.split_once('\t') {
+                let _ = writeln!(o, "        {:?} => {:?},", unescape(k), unescape(v));
+            }
+        }
+        let _ = writeln!(o, "        _ => return None,\n    }})\n}}");
+    }
     o
 }
 
+/// The catalog escapes `\n`, `\t` and `\\`.
+fn unescape(s: &str) -> String {
+    let mut out = String::with_capacity(s.len());
+    let mut chars = s.chars();
+    while let Some(c) = chars.next() {
+        if c != '\\' {
+            out.push(c);
+            continue;
+        }
+        match chars.next() {
+            Some('n') => out.push('\n'),
+            Some('t') => out.push('\t'),
+            Some(other) => out.push(other),
+            None => out.push('\\'),
+        }
+    }
+    out
+}
+
 fn generate_upstream() -> String {
     let mut o = String::from("// GENERATED by build_office.rs (no overlay: upstream values). Do not edit.\n");
     let _ = writeln!(o, "pub const ACTIVE: bool = false;");
@@ -115,5 +170,5 @@ fn generate_upstream() -> String {
     let _ = writeln!(o, "pub const LINK_WEBSITE: &str = \"\";");
     let _ = writeln!(o, "pub static ICON_PNG: Option<&[u8]> = None;");
     let _ = writeln!(o, "pub static FALLBACK_FONTS: &[(&str, &[u8])] = &[];");
-    o
+    o + &uzbek(None)
 }
diff --git a/crates/ui-egui/src/i18n.rs b/crates/ui-egui/src/i18n.rs
index b2dcb6f..7d2d7a0 100644
--- a/crates/ui-egui/src/i18n.rs
+++ b/crates/ui-egui/src/i18n.rs
@@ -35,10 +35,32 @@ pub enum Language {
     Cs,
     Fr,
     Sr,
+    #[cfg(office_uz)]
+    #[serde(rename = "uz-latn")]
+    UzLatn,
+    #[cfg(office_uz)]
+    #[serde(rename = "uz-cyrl")]
+    UzCyrl,
 }
 
 impl Language {
-    pub const ALL: [Self; 11] = [Self::En, Self::Es, Self::Zh, Self::Ja, Self::Ko, Self::Ru, Self::PtBr, Self::De, Self::Cs, Self::Fr, Self::Sr];
+    pub const ALL: [Self; 11 + crate::office_overlay::EXTRA_LANGS] = [
+        Self::En,
+        Self::Es,
+        Self::Zh,
+        Self::Ja,
+        Self::Ko,
+        Self::Ru,
+        Self::PtBr,
+        Self::De,
+        Self::Cs,
+        Self::Fr,
+        Self::Sr,
+        #[cfg(office_uz)]
+        Self::UzLatn,
+        #[cfg(office_uz)]
+        Self::UzCyrl,
+    ];
 
     /// The language's own name, shown in the switcher.
     pub fn name(self) -> &'static str {
@@ -54,6 +76,10 @@ impl Language {
             Self::Cs => "Čeština",
             Self::Fr => "Français",
             Self::Sr => "Srpski",
+            #[cfg(office_uz)]
+            Self::UzLatn => crate::office_overlay::NAME_UZ_LATN,
+            #[cfg(office_uz)]
+            Self::UzCyrl => crate::office_overlay::NAME_UZ_CYRL,
         }
     }
 
@@ -71,6 +97,10 @@ impl Language {
             Self::Cs => "cs",
             Self::Fr => "fr",
             Self::Sr => "sr",
+            #[cfg(office_uz)]
+            Self::UzLatn => "uz-latn",
+            #[cfg(office_uz)]
+            Self::UzCyrl => "uz-cyrl",
         }
     }
 
@@ -91,6 +121,11 @@ impl Language {
             "cs" => Some(Self::Cs),
             "fr" => Some(Self::Fr),
             "sr" => Some(Self::Sr),
+            // Uzbek: Latin unless the tag says Cyrillic (`uz-Cyrl-UZ`, or the Linux `uz_UZ@cyrillic`).
+            #[cfg(office_uz)]
+            "uz" if tag.to_ascii_lowercase().contains("cyrl") || tag.to_ascii_lowercase().contains("@cyrillic") => Some(Self::UzCyrl),
+            #[cfg(office_uz)]
+            "uz" => Some(Self::UzLatn),
             _ => None,
         }
     }
@@ -129,6 +164,10 @@ impl Language {
             Self::Cs => cs::translate(text),
             Self::Fr => fr::translate(text),
             Self::Sr => sr::translate(text),
+            #[cfg(office_uz)]
+            Self::UzLatn => crate::office_overlay::translate_uz_latn(text),
+            #[cfg(office_uz)]
+            Self::UzCyrl => crate::office_overlay::translate_uz_cyrl(text),
         };
         crate::office_overlay::rebrand(translated.unwrap_or_else(|| text.rsplit_once('|').map_or(text, |(_, label)| label)))
     }
diff --git a/crates/ui-egui/src/office_overlay_tests.rs b/crates/ui-egui/src/office_overlay_tests.rs
index dbead09..e9357ef 100644
--- a/crates/ui-egui/src/office_overlay_tests.rs
+++ b/crates/ui-egui/src/office_overlay_tests.rs
@@ -99,3 +99,21 @@ fn pdf_default_face_covers_uzbek() {
     let font = gridcraft_engine::pdf_fonts::for_text(gridcraft_engine::pdf_fonts::resolve("Arial", false, false), UZBEK_TEXT);
     assert!(font.covers(UZBEK_TEXT));
 }
+
+#[test]
+fn uzbek_is_offered_only_with_the_overlay_catalogs() {
+    if cfg!(office_uz) {
+        // Windows script tags, scriptless tags, and the Linux `@cyrillic` modifier.
+        let code = |tag: &str| Language::parse(tag).map(Language::code);
+        assert_eq!(code("uz-Latn-UZ"), Some("uz-latn"));
+        assert_eq!(code("uz-Cyrl-UZ"), Some("uz-cyrl"));
+        assert_eq!((code("uz"), code("uz-UZ"), code("uz_UZ.UTF-8")), (Some("uz-latn"), Some("uz-latn"), Some("uz-latn")));
+        assert_eq!(code("uz_UZ@cyrillic"), Some("uz-cyrl"));
+        let (latn, cyrl) = (Language::parse("uz-latn").expect("uz-latn"), Language::parse("uz-cyrl").expect("uz-cyrl"));
+        assert!(latn.name().starts_with("O\u{2bb}zbekcha") && cyrl.name().starts_with("Ўзбекча"));
+        assert_ne!(latn.tr("Paste"), "Paste");
+        assert_ne!(cyrl.tr("Paste"), "Paste");
+    } else {
+        assert!(Language::parse("uz-Latn-UZ").is_none());
+    }
+}
