From: office <office@localhost>
Date: Sat, 17 Oct 2026 16:07:09 +0500
Subject: [PATCH 102/102] ui-egui, engine: append the overlay's fallback fonts
 last and use them for PDF export

font_definitions_with appends the Noto Sans / Noto Sans Mono subsets (office-fallback-sans,
office-fallback-mono) after every other face of every family. For PDF export the sans subset
becomes the default face, with Ubuntu Light behind it (new pdf_fonts::set_default_face_with_fallback),
so U+02BB and Uzbek Cyrillic are embedded instead of printed as notdef. Adds cmap coverage tests.
---
 crates/engine/src/pdf_fonts.rs             | 14 ++++
 crates/ui-egui/src/office_overlay_tests.rs | 76 ++++++++++++++++++++++
 crates/ui-egui/src/theme.rs                |  7 +-
 3 files changed, 96 insertions(+), 1 deletion(-)

diff --git a/crates/engine/src/pdf_fonts.rs b/crates/engine/src/pdf_fonts.rs
index 6f0bed5..44d4276 100644
--- a/crates/engine/src/pdf_fonts.rs
+++ b/crates/engine/src/pdf_fonts.rs
@@ -92,6 +92,20 @@ pub fn set_default_face(data: Vec<u8>) -> bool {
     true
 }
 
+/// [`set_default_face`] with a second face behind `data` for the characters it lacks (the first successful call wins).
+pub fn set_default_face_with_fallback(data: Vec<u8>, fallback: Vec<u8>) -> bool {
+    if with_state(|s| s.default.is_some_and(|d| d.is_some())) {
+        return true;
+    }
+    let behind = register_face(fallback, 0, None);
+    let Some(font) = register_face(data, 0, behind) else { return false };
+    with_state(|s| {
+        s.default = Some(Some(font));
+        s.cache.clear();
+    });
+    true
+}
+
 /// The face compiled in with the `bundled-pdf-font` feature (and in this crate's tests).
 fn bundled() -> Option<Font> {
     #[cfg(any(test, feature = "bundled-pdf-font"))]
diff --git a/crates/ui-egui/src/office_overlay_tests.rs b/crates/ui-egui/src/office_overlay_tests.rs
index 8d9b059..dbead09 100644
