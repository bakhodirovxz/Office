--- a/crates/engine/src/tests.rs
+++ b/crates/engine/src/tests.rs
@@ -3344,3 +3344,29 @@ fn csv_as_text_keeps_identifier_columns_as_written() {
     let saved = s.execute("file.saveBytes", json!({"format": "csv"})).unwrap();
     assert_eq!(crate::io::base64_decode(saved["base64"].as_str().unwrap()).unwrap(), csv.replace('\n', "\r\n").as_bytes());
 }
+
+/// office overlay (gridcraft/0151): a new workbook is Times New Roman 12 pt with Excel's 15.75 pt (21 px) rows for that font; its
+/// sheets print on A4 in an Uzbek or Russian interface and on Letter in English; Insert Sheet matches the workbook; a 12 pt cell
+/// keeps the default row height.
+#[test]
+fn new_workbooks_are_times_new_roman_12_on_the_interface_paper() {
+    let mut s = Session::new();
+    s.new_workbook();
+    {
+        let wb = &s.doc().unwrap().wb;
+        let f = &wb.styles.get(gridcraft_model::StyleId::DEFAULT).font;
+        assert_eq!((f.name.as_str(), f.size), ("Times New Roman", 12.0));
+        let sh = wb.active().unwrap();
+        assert_eq!((sh.default_row_height, sh.print.paper.as_str()), (21.0, "Letter"));
+    }
+    s.prefs.num_locale = gridcraft_core::NumLocale::UzLatn;
+    s.new_workbook();
+    assert_eq!(s.doc().unwrap().wb.active().unwrap().print.paper, "A4");
+    s.execute("cell.set", json!({"cell": "A1", "input": "matn"})).unwrap();
+    assert!(s.doc().unwrap().wb.active().unwrap().rows.get(&0).is_none_or(|r| r.size.is_none()), "12 pt text keeps the default row");
+    s.execute("home.insertSheet", json!({})).unwrap();
+    let sh = s.doc().unwrap().wb.active().unwrap();
+    assert_eq!((sh.default_row_height, sh.print.paper.as_str()), (21.0, "A4"));
+    s.prefs.num_locale = gridcraft_core::NumLocale::Ru;
+    assert_eq!(s.new_sheet_paper(), "A4");
+}
diff --git a/crates/model/src/lib.rs b/crates/model/src/lib.rs
index 7d9f2bd..746b08a 100644
--- a/crates/model/src/lib.rs
+++ b/crates/model/src/lib.rs
@@ -31,3 +31,9 @@ pub use workbook::{CalcMode, CalcSettings, DefinedName, DocProps, Workbook};
 /// (e.g. the metric-compatible Carlito) when it isn't installed.
 pub const DEFAULT_FONT: &str = "Calibri";
 pub const DEFAULT_FONT_SIZE: f32 = 11.0;
+/// office overlay (gridcraft/0151): the Normal font of new workbooks (owner decision 2026-10-29). Not bundled: Windows has it;
+/// elsewhere the renderers substitute a metric-compatible serif (Liberation Serif, Tinos) when one is installed.
+pub const NEW_WORKBOOK_FONT: &str = "Times New Roman";
+pub const NEW_WORKBOOK_FONT_SIZE: f32 = 12.0;
+/// The default row height Excel gives that font: 15.75 pt (21 px) where Calibri 11 has 15 pt (20 px).
+pub const NEW_WORKBOOK_ROW_HEIGHT: f32 = 21.0;
diff --git a/crates/model/src/workbook.rs b/crates/model/src/workbook.rs
index bba81b7..512879f 100644
--- a/crates/model/src/workbook.rs
+++ b/crates/model/src/workbook.rs
@@ -162,6 +162,16 @@ impl Workbook {
     pub fn active(&self) -> Option<&Sheet> {
         self.sheet(self.active_sheet)
     }
+    /// office overlay (gridcraft/0151): the default row height of a sheet added to this workbook: the height Excel gives the
+    /// new-workbook font when that is the Normal font, else the Calibri 11 one (the height upstream always used).
+    pub fn new_sheet_row_height(&self) -> f32 {
+        let f = &self.styles.get(crate::StyleId::DEFAULT).font;
+        if f.name == crate::NEW_WORKBOOK_FONT && f.size == crate::NEW_WORKBOOK_FONT_SIZE {
+            crate::NEW_WORKBOOK_ROW_HEIGHT
+        } else {
+            crate::DEFAULT_ROW_HEIGHT
+        }
+    }
     /// A fresh sheet name `SheetN` not in use.
     pub fn next_sheet_name(&self) -> String {
         (1..).map(|n| format!("Sheet{n}")).find(|n| self.sheet_index(n).is_none()).unwrap_or_else(|| "Sheet".into())
