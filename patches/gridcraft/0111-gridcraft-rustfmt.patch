 crates/engine/src/pdf_fonts.rs           |  7 +++--
 crates/engine/tests/formula_templates.rs |  5 +---
 crates/model/src/store.rs                | 44 +++++++++++++++++++++++++++-----
 crates/pdf/src/embed.rs                  |  3 ++-
 crates/pdf/src/lib.rs                    | 25 +++++++++++++++---
 6 files changed, 70 insertions(+), 26 deletions(-)

