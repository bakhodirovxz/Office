diff --git a/crates/model/src/lib.rs b/crates/model/src/lib.rs
index 746b08a..b911dd7 100644
--- a/crates/model/src/lib.rs
+++ b/crates/model/src/lib.rs
@@ -37,3 +37,15 @@ pub const NEW_WORKBOOK_FONT: &str = "Times New Roman";
 pub const NEW_WORKBOOK_FONT_SIZE: f32 = 12.0;
 /// The default row height Excel gives that font: 15.75 pt (21 px) where Calibri 11 has 15 pt (20 px).
 pub const NEW_WORKBOOK_ROW_HEIGHT: f32 = 21.0;
+
+/// Maximum digit width (px at 96 dpi) of a Normal font, ECMA-376 18.3.1.13. Only fonts whose width is known are listed:
+/// Times New Roman digits are 0.5 em, so 12 pt (16 px) gives 8; Calibri 11 gives Excel's 7 (the model's unit elsewhere).
+pub fn max_digit_width(font: &str, size: f32) -> f64 {
+    if font == "Times New Roman" { (size as f64 * 4.0 / 3.0 * 0.5).round().max(1.0) } else { 7.0 }
+}
+
+/// Default column width (px) of a sheet whose Normal font is `font`, with `baseColWidth` characters (spec default 8):
+/// characters plus 5 px padding, rounded up to a multiple of 8 px (18.3.1.81). 64 for Calibri 11, 72 for Times New Roman 12.
+pub fn default_col_width_px(font: &str, size: f32, base_col_width: f64) -> f32 {
+    ((base_col_width.clamp(0.0, 255.0) * max_digit_width(font, size) + 5.0) / 8.0).ceil() as f32 * 8.0
+}
diff --git a/crates/xlsx/src/sheet_read.rs b/crates/xlsx/src/sheet_read.rs
index b81756b..17d299a 100644
--- a/crates/xlsx/src/sheet_read.rs
+++ b/crates/xlsx/src/sheet_read.rs
@@ -120,9 +120,10 @@ pub fn read_sheet(cx: &mut Ctx<'_>, part: &str, name: &str) -> Result<Sheet, IoE
                     if px > 0.0 {
                         sheet.default_col_width = px;
                     }
-                } else if let Some(b) = e.attr_f64("baseColWidth") {
-                    let px = ((b.clamp(0.0, 255.0) * 7.0 + 5.0) / 8.0).ceil() * 8.0;
-                    sheet.default_col_width = px as f32;
+                } else {
+                    // Neither width given: the spec's derivation from the Normal font (baseColWidth defaults to 8).
+                    let f = &cx.styles.get(gridcraft_model::StyleId::DEFAULT).font;
+                    sheet.default_col_width = gridcraft_model::default_col_width_px(&f.name, f.size, e.attr_f64("baseColWidth").unwrap_or(8.0));
                 }
             }
             "cols" => read_cols(cx, e, &mut sheet),
diff --git a/crates/xlsx/src/sheet_write.rs b/crates/xlsx/src/sheet_write.rs
index 8d8948e..9e7bf60 100644
--- a/crates/xlsx/src/sheet_write.rs
+++ b/crates/xlsx/src/sheet_write.rs
@@ -292,7 +292,9 @@ pub fn write_sheet(wb: &Workbook, si: usize, selected: bool, out: &mut Out) -> (
     let max_row_outline = sheet.rows.values().map(|r| r.outline).max().unwrap_or(0);
     let max_col_outline = sheet.cols.values().map(|r| r.outline).max().unwrap_or(0);
     s.push_str("<sheetFormatPr");
-    if (sheet.default_col_width - gridcraft_model::DEFAULT_COL_WIDTH).abs() > 0.01 {
+    // Omitted when it is what a reader derives from the Normal font (so Excel derives the same width itself).
+    let nf = &wb.styles.get(gridcraft_model::StyleId::DEFAULT).font;
+    if (sheet.default_col_width - gridcraft_model::default_col_width_px(&nf.name, nf.size, 8.0)).abs() > 0.01 {
         let _ = write!(s, " defaultColWidth=\"{}\"", num(px_to_col_width(sheet.default_col_width)));
     }
     let _ = write!(s, " defaultRowHeight=\"{}\"", num(px_to_pt(sheet.default_row_height)));
diff --git a/crates/xlsx/src/tests/roundtrip.rs b/crates/xlsx/src/tests/roundtrip.rs
index 872feae..bcc243c 100644
--- a/crates/xlsx/src/tests/roundtrip.rs
+++ b/crates/xlsx/src/tests/roundtrip.rs
@@ -1166,3 +1166,27 @@ fn doc_props_keep_boundary_whitespace() {
     let (back, _) = read_xlsx(&write_xlsx(&wb).unwrap()).unwrap();
     assert_eq!(back.props, wb.props);
 }
+
+/// Default column width follows the Normal font (ECMA-376 18.3.1.81): explicit values are kept, baseColWidth/nothing derive.
+#[test]
+fn default_col_width_follows_the_normal_font() {
+    use gridcraft_model::{StyleId, StyleTable};
+    let px = |wb: &Workbook| read_xlsx(&write_xlsx(wb).unwrap()).unwrap().0.sheets[0].default_col_width;
+    // Calibri 11: 64 px, and nothing written.
+    let mut wb = Workbook::new();
+    assert_eq!(px(&wb), 64.0);
+    // Times New Roman 12 (a new workbook): 72 px; written without defaultColWidth, derived back from the font.
+    let mut n = wb.styles.get(StyleId::DEFAULT).clone();
+    n.font.name = "Times New Roman".into();
+    n.font.size = 12.0;
+    wb.styles = StyleTable::with_default(n);
+    Arc::make_mut(&mut wb.sheets[0]).default_col_width = 72.0;
+    let bytes = write_xlsx(&wb).unwrap();
+    assert!(!String::from_utf8_lossy(&Package::open(&bytes).unwrap().read("xl/worksheets/sheet1.xml").unwrap().unwrap()).contains("defaultColWidth"));
+    assert_eq!(px(&wb), 72.0);
+    // An explicit width survives in any Normal font.
+    Arc::make_mut(&mut wb.sheets[0]).default_col_width = 100.0;
+    assert_eq!(px(&wb), 100.0);
+    assert_eq!(gridcraft_model::default_col_width_px("Calibri", 11.0, 10.0), 80.0);
+    assert_eq!(gridcraft_model::default_col_width_px("Times New Roman", 12.0, 10.0), 88.0);
+}
