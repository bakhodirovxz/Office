From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: x <a@b>
Date: Sun, 1 Nov 2026 12:00:00 +0500
Subject: [PATCH] gridcraft: rustfmt the files patches added after the first rustfmt pass

rustfmt --edition 2024 over the .rs files the queue touches, so cargo fmt --all --check is clean in CI lint. No behaviour change.
Last patch of the queue: regenerate it on every sync and after a new patch leaves a file unformatted.
---

diff --git a/crates/engine/src/lib.rs b/crates/engine/src/lib.rs
index 80098ed..4bf8dbe 100644
--- a/crates/engine/src/lib.rs
+++ b/crates/engine/src/lib.rs
@@ -338,7 +338,8 @@ impl Session {
         for sh in wb.sheets.iter_mut() {
             let sh = Arc::make_mut(sh);
             sh.default_row_height = gridcraft_model::NEW_WORKBOOK_ROW_HEIGHT;
-            sh.default_col_width = gridcraft_model::default_col_width_px(gridcraft_model::NEW_WORKBOOK_FONT, gridcraft_model::NEW_WORKBOOK_FONT_SIZE, 8.0);
+            sh.default_col_width =
+                gridcraft_model::default_col_width_px(gridcraft_model::NEW_WORKBOOK_FONT, gridcraft_model::NEW_WORKBOOK_FONT_SIZE, 8.0);
             sh.print.paper = paper.into();
         }
         self.add_document(DocState::new(wb, None, format!("Book{n}")))
diff --git a/crates/ui-egui/src/backstage.rs b/crates/ui-egui/src/backstage.rs
index 3ec1bfa..9fa2685 100644
--- a/crates/ui-egui/src/backstage.rs
+++ b/crates/ui-egui/src/backstage.rs
@@ -792,7 +792,15 @@ const PREVIEW_COLS: u32 = 60;
 
 /// Draws one printed page in miniature: the cells' displayed text at the page's print scale,
 /// inside the sheet's margins. `paper_w` is the page width in points.
-fn paint_page(p: &egui::Painter, rect: Rect, paper_w: f32, page: &Json, wb: &gridcraft_engine::model::Workbook, t: &Tokens, loc: gridcraft_engine::core::NumLocale) {
+fn paint_page(
+    p: &egui::Painter,
+    rect: Rect,
+    paper_w: f32,
+    page: &Json,
+    wb: &gridcraft_engine::model::Workbook,
+    t: &Tokens,
+    loc: gridcraft_engine::core::NumLocale,
+) {
     let Some(range) = page.get("range").and_then(Json::as_str).and_then(gridcraft_engine::core::RangeRef::parse) else { return };
     let Some(sh) = page.get("sheet").and_then(Json::as_str).and_then(|n| wb.sheet_index(n)).and_then(|i| wb.sheets.get(i)) else { return };
     // Preview pixels per point, and per sheet pixel (sheet geometry is 96 dpi: 0.75 pt per pixel).
diff --git a/crates/xlsx/src/sheet_write.rs b/crates/xlsx/src/sheet_write.rs
index aa1537c..1886d35 100644
--- a/crates/xlsx/src/sheet_write.rs
+++ b/crates/xlsx/src/sheet_write.rs
@@ -169,7 +169,10 @@ pub fn write_sheet(wb: &Workbook, si: usize, selected: bool, out: &mut Out) -> (
     let mut rels = Rels::default();
     let Some(sheet) = wb.sheet(si) else { return (String::new(), rels) };
     let nstyles = wb.styles.len() as u32;
-    let mdw = gridcraft_model::max_digit_width(&wb.styles.get(gridcraft_model::StyleId::DEFAULT).font.name, wb.styles.get(gridcraft_model::StyleId::DEFAULT).font.size);
+    let mdw = gridcraft_model::max_digit_width(
+        &wb.styles.get(gridcraft_model::StyleId::DEFAULT).font.name,
+        wb.styles.get(gridcraft_model::StyleId::DEFAULT).font.size,
+    );
     let sid = |s: gridcraft_model::StyleId| if s.0 < nstyles { s.0 } else { 0 };
 
     // Table header cells must hold the column names.
