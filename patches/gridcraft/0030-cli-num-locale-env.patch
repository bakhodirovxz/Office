From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office-wp14 <wp14@office.invalid>
Date: Wed, 21 Oct 2026 12:00:00 +0500
Subject: [PATCH 30/42] cli: GRIDCRAFT_NUM_LOCALE sets the number locale of
 sheets-cli sessions

en, ru, uz-latn or uz-cyrl, so cat, convert and run show and write cells as that locale's readers
see them (the locale matrix, tests). Unset is en-US.
---
 apps/gridcraft-cli/src/main.rs | 20 +++++++++++++++-----
 1 file changed, 15 insertions(+), 5 deletions(-)

diff --git a/apps/gridcraft-cli/src/main.rs b/apps/gridcraft-cli/src/main.rs
index 152ddbcb..b0f41150 100644
--- a/apps/gridcraft-cli/src/main.rs
+++ b/apps/gridcraft-cli/src/main.rs
@@ -163,14 +163,24 @@ fn exec(s: &mut Session, id: &str, params: Value) -> Result<Value, String> {
     r
 }
 
-fn open(path: &str) -> Result<Session, String> {
+/// A session whose number locale is `GRIDCRAFT_NUM_LOCALE` (en-US when unset), so `cat`, `convert` and
+/// `run` show and write cells as a reader of that locale sees them.
+fn new_session() -> Session {
     let mut s = Session::new();
+    if let Some(loc) = gridcraft_engine::env_num_locale() {
+        s.prefs.num_locale = loc;
+    }
+    s
+}
+
+fn open(path: &str) -> Result<Session, String> {
+    let mut s = new_session();
     exec(&mut s, "file.open", json!({"path": path}))?;
     Ok(s)
 }
 
 fn blank() -> Session {
-    let mut s = Session::new();
+    let mut s = new_session();
     s.new_workbook();
     s
 }
@@ -277,7 +287,7 @@ fn convert(args: &[String]) -> Result<(), String> {
     let mut s = open(input)?;
     activate_sheet(&mut s, a.opt("sheet"))?;
     let d = s.doc().map_err(|e| e.to_string())?;
-    let bytes = gridcraft_engine::io::save_file_bytes(&d.wb, out).map_err(|e| e.to_string())?;
+    let bytes = gridcraft_engine::io::save_file_bytes_in(&d.wb, out, s.prefs.num_locale).map_err(|e| e.to_string())?;
     gridcraft_engine::io::write_file(out, &bytes).map_err(|e| e.to_string())?;
     eprintln!("wrote {out} ({} bytes)", bytes.len());
     Ok(())
@@ -388,7 +398,7 @@ fn run(args: &[String]) -> Result<(), String> {
         (Some(_), Some(_)) => return Err("give --in or --sample, not both".into()),
         (Some(p), None) => open(p)?,
         (None, Some(name)) => {
-            let mut s = Session::new();
+            let mut s = new_session();
             exec(&mut s, "file.new", json!({"sample": name}))?;
             s
         }
@@ -510,7 +520,7 @@ fn mcp(args: &[String]) -> Result<(), String> {
             let session = match (a.opt("in"), a.opt("sample")) {
                 (Some(p), _) => open(p)?,
                 (None, Some(name)) => {
-                    let mut s = Session::new();
+                    let mut s = new_session();
                     exec(&mut s, "file.new", json!({"sample": name}))?;
                     s
                 }
