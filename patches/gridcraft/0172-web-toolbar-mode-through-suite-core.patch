From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Mon, 9 Nov 2026 12:00:00 +0500
Subject: [PATCH] gridcraft: on the web the toolbar mode is suite-core's (saved choice, then ?toolbar=, then simple) and the switch is offered

Hengines task 4. The web build used to be always simple and offered no switch. It now reads the mode through suite_core::settings::toolbar_mode(), which on wasm is the user's saved choice (localStorage), then the URL's ?toolbar=full|simple (the document server passes it), then simple. The Full ribbon / Simple ribbon switch is offered on the web too and saves the choice through suite_core::settings::set_toolbar_mode (localStorage). Full mode is upstream's ribbon.

---

diff --git a/crates/ui-egui/src/office_toolbar.rs b/crates/ui-egui/src/office_toolbar.rs
index 07c4017..f1bb82b 100644
--- a/crates/ui-egui/src/office_toolbar.rs
+++ b/crates/ui-egui/src/office_toolbar.rs
@@ -151,7 +151,7 @@ pub fn set_simple(on: bool) {
 }
 
 fn offered() -> bool {
-    !cfg!(target_arch = "wasm32") && (office_overlay::ACTIVE || OFFERED.load(Ordering::Relaxed) == 1)
+    office_overlay::ACTIVE || OFFERED.load(Ordering::Relaxed) == 1
 }
 
 /// The toggle button: switches at once and remembers the choice for the next start.
@@ -172,6 +172,11 @@ fn toggle_mode(on: bool) {
             log::warn!("could not write the toolbar mode: {e}");
         }
     }
+    // The web keeps the choice in localStorage (suite-core).
+    #[cfg(target_arch = "wasm32")]
+    if let Err(e) = suite_core::settings::set_toolbar_mode(if on { suite_core::settings::ToolbarMode::Simple } else { suite_core::settings::ToolbarMode::Full }) {
+        log::warn!("could not write the toolbar mode: {e}");
+    }
 }
 
 /// Reads and writes `settings.toml` in `dir` instead of the user's folder (tests, and a host that keeps its own).
@@ -188,7 +193,7 @@ fn settings_dir() -> Option<std::path::PathBuf> {
     SETTINGS_DIR.lock().unwrap_or_else(|e| e.into_inner()).clone()
 }
 
-/// The shared setting (`toolbar` in settings.toml, suite-core). The web has no file and is always simple.
+/// The shared setting (`toolbar` in settings.toml, suite-core). The web: the saved choice in localStorage, then `?toolbar=`, then simple.
 fn read_mode() -> bool {
     #[cfg(not(target_arch = "wasm32"))]
     return match settings_dir() {
@@ -196,7 +201,7 @@ fn read_mode() -> bool {
         None => suite_core::settings::toolbar_mode(),
     } == suite_core::settings::ToolbarMode::Simple;
     #[cfg(target_arch = "wasm32")]
-    true
+    return suite_core::settings::toolbar_mode() == suite_core::settings::ToolbarMode::Simple;
 }
 
