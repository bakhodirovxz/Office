From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Sun, 8 Nov 2026 12:00:00 +0500
Subject: [PATCH] gridcraft: a read-only workbook opens no edit dialog, takes no typing in the chart-title, table-name and reply fields, and its empty header and footer zones neither frame nor invite

0162 refused the cell, header/footer and text box editors. Three more places still took typed text: a form dialog whose command a read-only
session refuses (New Comment, New Note, Format Cells, ...) opened and showed what was typed into it; widgets::committed_text (chart title and
axis titles, the table name) and the Comments pane's reply box showed typed text; and a sheet tab's double-click began a rename. SheetApp::
open_dialog now refuses a form whose command Session reports as refused in a read-only session (the same toast), those two fields are not
interactive (committed_text reads a context flag SheetApp::ui sets each frame), the tab rename does not start, and in Page Layout view the
empty header/footer zones draw no hover frame and no "Add header" invitation. With the session editable nothing changes.
Test: ci/web-smoke/bridge-sheets.spec.ts (note dialog, header editor, text box editor), each against an editable control.
---

diff --git a/crates/ui-egui/src/lib.rs b/crates/ui-egui/src/lib.rs
index 7660ef7..08ef909 100644
--- a/crates/ui-egui/src/lib.rs
+++ b/crates/ui-egui/src/lib.rs
@@ -802,7 +802,16 @@ impl SheetApp {
                 let page = params.get("page").and_then(Json::as_str).and_then(backstage::Page::parse).unwrap_or(backstage::Page::Home);
                 self.open_backstage(page);
             }
-            other => self.dialog = dialogs::Dialog::open(self, other, params),
+            other => {
+                let d = dialogs::Dialog::open(self, other, params);
+                // A form whose command a read-only session refuses (comment, note, ...) is not opened: nothing can be typed into it.
+                let edits = d.as_ref().and_then(|d| d.command).and_then(gridcraft_engine::find_command).is_some_and(gridcraft_engine::cmd::refuses_when_read_only);
+                if !(self.session.read_only && edits) {
+                    self.dialog = d;
+                } else {
+                    self.refuse_read_only();
+                }
+            }
         }
     }
 
@@ -1192,6 +1201,7 @@ impl SheetApp {
             return;
         }
         let t0 = now_ms();
+        ctx.data_mut(|d| d.insert_temp(egui::Id::new("edits-barred"), self.session.read_only));
         text_box::before_ui(self, &ctx);
         // The language the widgets translate with this frame (see `i18n::current`).
         i18n::set_current(&ctx, self.ui.language);
