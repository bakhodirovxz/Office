From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Fri, 6 Nov 2026 12:00:00 +0500
Subject: [PATCH] gridcraft: the transliteration's cell walk and write as functions (plugin text map)

Phase 7 WP13 (docs/phase7/PLAN.md WP13, docs/plugins.md section 6a): the plugin text map of sheets-plugins must hold exactly the
cells the transliteration commands convert, and write them the way the commands do, so a plugin's result equals the built-in's.
`run` is split, with no behaviour change: `collect` (the constant text cells of the scope, with the skip counts) and
`write_texts` (one `edit`, one recalculation); `text_cells` is `collect` for a caller outside the engine. Our module (0120).
---

diff --git a/crates/engine/src/cmd/translit.rs b/crates/engine/src/cmd/translit.rs
index 23ffa1f..80f72b9 100644
--- a/crates/engine/src/cmd/translit.rs
+++ b/crates/engine/src/cmd/translit.rs
@@ -118,6 +118,44 @@ fn run(s: &mut Session, p: &Json, dir: Option<Direction>) -> Result<Json> {
     };
 
     let t0 = now_ms();
+    let (scope, found, st) = collect(s, p, scope)?;
+    let dir = dir.or_else(|| {
+        let all: String = found.iter().flat_map(|(_, _, t)| [t.as_ref(), "\n"]).collect();
+        uz_translit::detect(&all).map(|sc| if sc == Script::Latin { Direction::ToCyrillic } else { Direction::ToLatin })
+    });
+    let mut changes = Vec::new();
+    if let Some(dir) = dir {
+        for (si, c, t) in &found {
+            let new = uz_translit::convert(t, dir, &opts);
+            if new != **t {
+                changes.push((*si, *c, new));
+            }
+        }
+    }
+    let t1 = now_ms();
+    let n = changes.len();
+    if n > 0 {
+        write_texts(s, changes)?;
+    }
+    let t2 = now_ms();
+    Ok(json!({
+        "direction": match dir { Some(Direction::ToCyrillic) => "cyrl", Some(Direction::ToLatin) => "latn", None => "none" },
+        "scope": match scope { Scope::Selection => "selection", Scope::Sheet => "sheet", _ => "workbook" },
+        "tracked": false,
+        "cells": n,
+        "runs": n,
+        "skipped": {"lang": 0, "formula": st.formula, "locked": st.locked, "header": st.header},
+        "formulasWithText": st.formulas_with_text,
+        "ms": {"convert": t1 - t0, "apply": t2 - t1},
+        "rulesVersion": uz_translit::RULES_VERSION,
+    }))
+}
