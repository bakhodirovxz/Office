 crates/ui-egui/src/palette.rs |  6 ++--
 crates/ui-egui/src/panels.rs  | 66 +++++++++++++----------------------
 crates/ui-egui/tests/ui.rs    |  4 ++-
 4 files changed, 32 insertions(+), 46 deletions(-)

