From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Sat, 24 Oct 2026 10:00:00 +0500
Subject: [PATCH] pdfcraft: crypto-bigint 0.7.6 and ctutils 0.4.5
 (RUSTSEC-2026-0387, RUSTSEC-2026-0385)

RUSTSEC-2026-0387: crypto-bigint 0.7.5 to 0.7.6 (variable-time operations); 0.7.6 needs ctutils 0.4.5, which also covers RUSTSEC-2026-0385 (was 0.4.2 to 0.4.4). Cargo.lock only.
---
 Cargo.lock | 8 ++++----
 1 file changed, 4 insertions(+), 4 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 3d9331a..2560b1c 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -1249,9 +1249,9 @@ checksum = "460fbee9c2c2f33933d720630a6a0bac33ba7053db5344fac858d4b8952d77d5"
 
 [[package]]
 name = "crypto-bigint"
-version = "0.7.5"
+version = "0.7.6"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "1a52aa3fcda4e6302a9f48734f234d35d4721b96f8fe07d073f07ce9df4f0271"
+checksum = "6bb08299a6046833a879ace115697f12fd2bd6c8d3e93c909ffc9e0738e7cae0"
 dependencies = [
  "cpubits",
  "ctutils",
@@ -1297,9 +1297,9 @@ dependencies = [
 
 [[package]]
 name = "ctutils"
-version = "0.4.2"
+version = "0.4.5"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "7d5515a3834141de9eafb9717ad39eea8247b5674e6066c404e8c4b365d2a29e"
+checksum = "38d28fb6aa7dd680b3ffd1a3e64e115c177bdba63c0ae7f9cd48129ff05c4fa0"
 dependencies = [
  "cmov",
  "subtle",
