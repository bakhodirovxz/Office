+        p.images[0].rect = [72.0, 380.0, 272.0, 530.0];
+        let row = |t: &str, x0: f64, y0: f64, x1: f64| (t.to_string(), [x0, y0, x1, y0 + 14.0]);
+        // Three rows 18 pt apart, the last one centred under the others (indented by 40 pt).
+        let rows =
