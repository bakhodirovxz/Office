 crates/annot/src/lib.rs               | 40 ++++++++++++++++++++++-----
 crates/annot/src/tests.rs             | 35 +++++++++++++++++++----
 crates/automation/tests/automation.rs |  4 +--
 crates/ui-egui/src/content_ui.rs      |  3 +-
 5 files changed, 91 insertions(+), 25 deletions(-)

