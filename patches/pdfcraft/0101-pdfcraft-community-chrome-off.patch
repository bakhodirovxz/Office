 crates/ui-egui/src/palette.rs  |  2 +-
 crates/ui-egui/src/updates.rs  |  2 +-
 crates/ui-egui/src/widgets.rs  | 17 +++++++++++++++
 8 files changed, 61 insertions(+), 31 deletions(-)

