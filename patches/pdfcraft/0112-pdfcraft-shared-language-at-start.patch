         _ => false,
     }
 }
+
+/// The shared `lang` setting (`settings.toml`, PLAN 5.1) as this app's language code (`en`, `ru`, `uz-latn`, `uz-cyrl`), read once.
+/// `None` for `auto`, with no file, in the web build and in tests: the app keeps its own detection there. `uz-Latn-2026` has no
+/// catalog in the apps yet (STATUS, deferred) and shows the `uz-latn` one.
+#[cfg(not(any(target_arch = "wasm32", test)))]
+pub fn shared_lang_code() -> Option<&'static str> {
+    static CODE: std::sync::OnceLock<Option<&'static str>> = std::sync::OnceLock::new();
+    *CODE.get_or_init(|| code_of(suite_core::settings::load().lang))
+}
+
+#[cfg(any(target_arch = "wasm32", test))]
+pub fn shared_lang_code() -> Option<&'static str> {
+    None
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) fn code_of(choice: suite_core::lang::LangChoice) -> Option<&'static str> {
+    use suite_core::lang::{Lang, LangChoice};
+    match choice {
+        LangChoice::Auto => None,
+        LangChoice::Fixed(Lang::En) => Some("en"),
+        LangChoice::Fixed(Lang::Ru) => Some("ru"),
+        LangChoice::Fixed(Lang::UzLatn | Lang::UzLatn2026) => Some("uz-latn"),
+        LangChoice::Fixed(Lang::UzCyrl) => Some("uz-cyrl"),
+    }
+}
diff --git a/crates/ui-egui/src/office_overlay_tests.rs b/crates/ui-egui/src/office_overlay_tests.rs
index 3cffbd4..d9776e4 100644
--- a/crates/ui-egui/src/office_overlay_tests.rs
+++ b/crates/ui-egui/src/office_overlay_tests.rs
@@ -71,3 +71,20 @@ fn uzbek_is_offered_only_with_the_overlay_catalogs() {
         assert!(pdfcraft_engine::dates::date_language("uz-latn").is_none());
     }
 }
+
+/// The shared `lang` setting reaches the app's catalog language (patches/pdfcraft/0112): `auto` leaves the app's own choice, a fixed
+/// language maps to the code the app registers.
+#[test]
+fn shared_lang_picks_the_catalog_language() {
+    use suite_core::lang::{Lang as S, LangChoice::{Auto, Fixed}};
+    assert_eq!(o::code_of(Auto), None);
+    assert_eq!(o::shared_lang_code(), None, "tests never read the user's settings");
+    for (choice, code) in [(Fixed(S::En), "en"), (Fixed(S::Ru), "ru"), (Fixed(S::UzLatn), "uz-latn"), (Fixed(S::UzLatn2026), "uz-latn"), (Fixed(S::UzCyrl), "uz-cyrl")] {
+        assert_eq!(o::code_of(choice), Some(code));
+        if let Some(l) = crate::i18n::Lang::from_code(code) {
+            assert_eq!(l.code(), code);
+        } else {
+            assert!(code.starts_with("uz") && !cfg!(office_uz), "{code} must be registered");
+        }
+    }
+}
