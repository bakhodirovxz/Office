From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Sun, 22 Nov 2026 12:00:00 +0500
Subject: [PATCH] ui-egui: the untagged-document status bar test clears the built-in en-US tag

The 0163 test built its "untagged" document with Document::from_text, whose built-in style sheet (StyleSheet::builtin)
has always set default_chr.lang = en-US, so its first assertion could never hold. A .docx with no w:lang reads into
StyleSheet::empty() (docx read/mod.rs), so the test now clears the default language. The product code is unchanged.
Test only.
---
 crates/ui-egui/src/ribbon.rs | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/crates/ui-egui/src/ribbon.rs b/crates/ui-egui/src/ribbon.rs
index 8c1c42f..d9d63e9 100644
--- a/crates/ui-egui/src/ribbon.rs
+++ b/crates/ui-egui/src/ribbon.rs
@@ -3347,7 +3347,10 @@ mod tests {
     #[cfg(office_uz)]
     #[test]
     fn status_bar_language_of_an_untagged_document_follows_an_uzbek_interface() {
-        let app = WordApp::new(Session::new(wordcraft_doc::Document::from_text("Salom")), crate::Services::default());
+        // A new document's built-in styles say en-US; a .docx with no w:lang reads into an empty style sheet (no language).
+        let mut doc = wordcraft_doc::Document::from_text("Salom");
+        doc.styles.default_chr.lang = None;
+        let app = WordApp::new(Session::new(doc), crate::Services::default());
         assert!(caret_lang_tag(&app).is_none());
         crate::i18n::set_current(crate::i18n::Lang::from_code("uz-latn").expect("the overlay adds uz-latn"));
         assert_eq!(caret_language(&app), crate::i18n::current().name());
