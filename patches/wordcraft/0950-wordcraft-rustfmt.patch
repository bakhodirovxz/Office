 crates/ui-egui/src/canvas.rs         |  4 ++-
 crates/ui-egui/src/office_overlay.rs |  4 ++-
 crates/ui-egui/src/touch_select.rs   | 10 ++++--
 7 files changed, 59 insertions(+), 39 deletions(-)

