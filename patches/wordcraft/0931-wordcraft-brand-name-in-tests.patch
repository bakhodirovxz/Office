From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Wed, 25 Nov 2026 12:00:00 +0500
Subject: [PATCH] tests: expect the overlay's product name where upstream's tests expect WordCraft

docx extended properties (Application), LaTeX header, the window title on the Start screen, the Start-up option label and the
default-app button label all carry the product name, which the overlay rebrands (patch 0100 hooks, 0101). The tests read
OFFICE_PRODUCT_NAME / office_overlay::app_name() / rebrand() (all equal 'WordCraft' without an overlay). The default-app test
used the community option as its page marker; the overlay turns that off (0101), so it uses the Start-up label.
---

diff --git a/crates/docx/tests/passthrough.rs b/crates/docx/tests/passthrough.rs
index 6de414b8..fe4d7056 100644
--- a/crates/docx/tests/passthrough.rs
+++ b/crates/docx/tests/passthrough.rs
@@ -337,7 +337,9 @@ fn extended_properties_are_kept_without_words_counts_and_personal_ones_follow_th
     for gone in ["Pages", "Characters", "Lines", "TotalTime", "AppVersion", "Microsoft Office Word", "40000"] {
         assert!(!a.contains(gone), "{gone}: {a}");
     }
-    assert!(a.contains("<Application>WordCraft</Application>"));
+    // The office overlay writes its product name (patch 0100 hook) where upstream writes WordCraft.
+    let product = option_env!("OFFICE_PRODUCT_NAME").unwrap_or("WordCraft");
+    assert!(a.contains(&format!("<Application>{product}</Application>")));
     let private = make(SETTINGS);
     assert!(!private.contains("Company") && !private.contains("Manager"), "{private}");
     assert!(private.contains("<Template>Normal.dotm</Template>"));
diff --git a/crates/formats/src/tests.rs b/crates/formats/src/tests.rs
index caad39dc..ad7393e0 100644
--- a/crates/formats/src/tests.rs
+++ b/crates/formats/src/tests.rs
@@ -249,7 +249,8 @@ fn odt_round_trip() {
 fn latex_round_trip() {
     check_round_trip("tex", true);
     let tex = String::from_utf8(export("tex", &sample()).unwrap().unwrap()).unwrap();
-    assert!(tex.starts_with("% Written by WordCraft") && tex.contains("\\documentclass{article}"), "{tex}");
+    let product = option_env!("OFFICE_PRODUCT_NAME").unwrap_or("WordCraft"); // the office overlay writes its own name
+    assert!(tex.starts_with(&format!("% Written by {product}")) && tex.contains("\\documentclass{article}"), "{tex}");
     assert!(tex.contains("\\section*{Main Heading}") && tex.contains("\\subsection*{Second Level}"), "{tex}");
     assert!(tex.contains("\\textbf{bold}") && tex.contains("\\textit{italic}"), "{tex}");
     assert!(tex.contains("\\href{https://example.com/x}{a link}"), "{tex}");
diff --git a/crates/ui-egui/src/lib.rs b/crates/ui-egui/src/lib.rs
index 4c6f0997..631baf63 100644
--- a/crates/ui-egui/src/lib.rs
+++ b/crates/ui-egui/src/lib.rs
@@ -3013,7 +3013,7 @@ mod tests {
         let a = h.state_mut();
         assert!(!a.ui.backstage, "Esc leaves the Start screen");
         assert!(!a.has_document(), "for an empty window, not a blank document");
-        assert_eq!(a.sent_title, "WordCraft", "the window is titled with the app alone");
+        assert_eq!(a.sent_title, office_overlay::app_name(), "the window is titled with the app alone");
         // The ribbon's commands are off, but Help, the File tab and the settings work.
         for id in ["format.bold", "text.insert", "file.save", "file.saveAs", "file.print", "edit.paste", "insert.table", "ui.print"] {
             assert!(!widgets::enabled(a, id), "{id} is off with no document");
@@ -5370,7 +5370,9 @@ mod tests {
     #[test]
     fn the_default_app_button_shows_only_with_the_hosts_hook() {
         use egui_kittest::kittest::Queryable;
-        const LABEL: &str = "Make WordCraft the default for Word documents…";
+        // The overlay rebrands the product name; the community option is off there (patch 0101), so the page is told by another label.
+        let label = office_overlay::rebrand("Make WordCraft the default for Word documents…");
+        let page_label = office_overlay::rebrand("Show the Start screen when WordCraft starts");
         for hook in [false, true] {
             let calls = std::rc::Rc::new(std::cell::Cell::new(0));
             let mut a = app();
@@ -5391,10 +5393,10 @@ mod tests {
                 a,
             );
             h.run_steps(4);
-            assert!(h.query_by_label("Show the community button in the title bar").is_some(), "hook {hook}: the Options page rendered");
-            assert_eq!(h.query_by_label(LABEL).is_some(), hook, "hook {hook}: the button");
+            assert!(h.query_by_label(page_label).is_some(), "hook {hook}: the Options page rendered");
+            assert_eq!(h.query_by_label(label).is_some(), hook, "hook {hook}: the button");
             if hook {
-                h.get_by_label(LABEL).click();
+                h.get_by_label(label).click();
                 h.run_steps(2);
                 assert_eq!(calls.get(), 1, "the button ran the hook");
             }
diff --git a/crates/ui-egui/src/options.rs b/crates/ui-egui/src/options.rs
index 8288192a..20ca8597 100644
--- a/crates/ui-egui/src/options.rs
+++ b/crates/ui-egui/src/options.rs
@@ -1033,10 +1033,10 @@ mod tests {
         );
         h.run_steps(4);
         assert!(h.query_by_label("Start-up").is_some(), "the section is there");
-        h.get_by_label("Show the Start screen when WordCraft starts").click();
+        h.get_by_label(crate::office_overlay::rebrand("Show the Start screen when WordCraft starts")).click();
         h.run_steps(4);
         assert!(!h.state().ui.start_screen, "the checkbox turns it off");
-        h.get_by_label("Show the Start screen when WordCraft starts").click();
+        h.get_by_label(crate::office_overlay::rebrand("Show the Start screen when WordCraft starts")).click();
         h.run_steps(4);
         assert!(h.state().ui.start_screen, "and on again");
     }
