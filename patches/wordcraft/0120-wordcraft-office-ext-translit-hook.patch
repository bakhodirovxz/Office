diff --git a/apps/wordcraft/src/main.rs b/apps/wordcraft/src/main.rs
index f737a82..dd83650 100644
--- a/apps/wordcraft/src/main.rs
+++ b/apps/wordcraft/src/main.rs
@@ -420,6 +420,8 @@ fn main() -> eframe::Result {
             let doc = if sample { wordcraft_engine::sample::sample_document() } else { wordcraft_engine::blank_document(&region) };
             let (file_dialog, dialogs) = file_dialogs::hook(&cc.egui_ctx);
             let mut session = Session::new(doc);
+            #[cfg(feature = "office-ext")]
+            docs_translit::install(&mut session);
             session.system_region = region;
             let mut app = WordApp::new(session, services(file_dialog, &cc.egui_ctx));
             load_prefs(&mut app);
diff --git a/crates/engine/src/cmd/column.rs b/crates/engine/src/cmd/column.rs
index 2fc5595..93255a4 100644
--- a/crates/engine/src/cmd/column.rs
+++ b/crates/engine/src/cmd/column.rs
@@ -175,7 +175,9 @@ pub(crate) fn dispatch(s: &mut Session, id: &str, mutates: bool, run: fn(&mut Se
             delete(s, &segs)?;
             super::sel_result(s)
         }
-        "format.changeCase" | "format.clear" | "format.resetChar" => per_row(s, run, v, &segs),
+        "format.changeCase" | "format.clear" | "format.resetChar" | "tools.translitCyrl" | "tools.translitLatn" | "tools.translitAuto" => {
+            per_row(s, run, v, &segs)
+        }
         _ if id.starts_with("format.") || id.starts_with("para.") || id == "select.column" => run(s, v),
         // Pasting formatting (the format painter) leaves the text alone.
         _ if mutates && (id.starts_with("text.") || (id.starts_with("edit.paste") && id != "edit.pasteFormat")) => {
