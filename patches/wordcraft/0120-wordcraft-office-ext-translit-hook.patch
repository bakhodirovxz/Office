diff --git a/apps/wordcraft/Cargo.toml b/apps/wordcraft/Cargo.toml
index 911da17..eefc853 100644
--- a/apps/wordcraft/Cargo.toml
+++ b/apps/wordcraft/Cargo.toml
@@ -10,6 +10,10 @@ description = "WordCraft desktop app"
 [lints]
 workspace = true
 
+# office overlay (patches/wordcraft/0120): the domain build turns this on and adds the docs-translit dependency
+[features]
+office-ext = []
+
 [dependencies]
