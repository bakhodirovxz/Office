From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Tue, 20 Oct 2026 23:14:52 +0500
Subject: [PATCH] ui-egui: office overlay merges its Russian catalog into the
 ru language

The Russian catalog that `cargo xt i18n export` writes next to overlay.env (upstream's own ru rows plus our rows,
in upstream's format) replaces the embedded ru.tsv when the overlay has one, so a Russian UI shows the Russian labels
of our menus. build_office.rs adds CATALOG_RU (empty without the file), and the ru LangInfo picks it. Upstream's
rows are unchanged by the export (its round trip proves it) and the new test reads every one of them back. Without
the file the ru language is upstream's.
---
 crates/ui-egui/build_office.rs             | 13 ++++++++++--
 crates/ui-egui/src/i18n/mod.rs             | 11 +++++++++--
 crates/ui-egui/src/office_overlay_tests.rs | 23 ++++++++++++++++++++++
 3 files changed, 43 insertions(+), 4 deletions(-)

diff --git a/crates/ui-egui/build_office.rs b/crates/ui-egui/build_office.rs
index a872628b..656a853b 100644
--- a/crates/ui-egui/build_office.rs
+++ b/crates/ui-egui/build_office.rs
@@ -95,7 +95,7 @@ fn generate(dir: &Path) -> String {
         let _ = write!(list, "({key:?}, include_bytes!({:?}) as &[u8]), ", include_path(dir, f));
     }
     let _ = writeln!(o, "pub static FALLBACK_FONTS: &[(&str, &[u8])] = &[{list}];");
-    o + &uzbek(Some(dir))
+    o + &uzbek(Some(dir)) + &russian(Some(dir))
 }
 
 /// The Uzbek catalogs that `cargo xt i18n export` wrote next to `overlay.env`. Only when both are there does the build
@@ -128,6 +128,15 @@ fn uzbek(dir: Option<&Path>) -> String {
     o
 }
 
+/// The Russian catalog that `cargo xt i18n export` wrote next to `overlay.env`: upstream's own Russian rows plus ours, in
+/// upstream's format. It replaces the embedded `ru.tsv`; empty (upstream's file stays) when the overlay has none.
+fn russian(dir: Option<&Path>) -> String {
+    let file = dir.map(|d| d.join("catalog-ru.tsv")).filter(|f| f.is_file());
+    let Some(file) = file else { return "pub const CATALOG_RU: &str = \"\";\n".into() };
+    println!("cargo::rerun-if-changed={}", file.display());
+    format!("pub const CATALOG_RU: &str = include_str!({:?});\n", file.to_string_lossy().replace(std::path::MAIN_SEPARATOR, "/"))
+}
+
 fn generate_upstream() -> String {
     let mut o = String::from("// GENERATED by build_office.rs (no overlay: upstream values). Do not edit.\n");
     let _ = writeln!(o, "pub const ACTIVE: bool = false;");
@@ -145,5 +154,5 @@ fn generate_upstream() -> String {
     let _ = writeln!(o, "pub const LINK_WEBSITE: &str = \"\";");
     let _ = writeln!(o, "pub static ICON_PNG: Option<&[u8]> = None;");
     let _ = writeln!(o, "pub static FALLBACK_FONTS: &[(&str, &[u8])] = &[];");
-    o + &uzbek(None)
+    o + &uzbek(None) + &russian(None)
 }
diff --git a/crates/ui-egui/src/i18n/mod.rs b/crates/ui-egui/src/i18n/mod.rs
index 23efdb3d..b9e5b797 100644
--- a/crates/ui-egui/src/i18n/mod.rs
+++ b/crates/ui-egui/src/i18n/mod.rs
@@ -131,8 +131,15 @@ pub static LANGUAGES: [LangInfo; 23 + crate::office_overlay::EXTRA_LANGS] = [
     // German, neutral across Germany, Austria and Switzerland; `de`, `de-DE`, `de-AT`, `de-CH` …
     // resolve here.
     LangInfo { code: "de", name: "Deutsch", source: include_str!("de.tsv"), prefer_hans: false, editing_lang: None, catalog: OnceLock::new() },
-    // Russian; `ru`, `ru-RU`, `ru_RU.UTF-8` and other regions resolve here.
-    LangInfo { code: "ru", name: "Русский", source: include_str!("ru.tsv"), prefer_hans: false, editing_lang: None, catalog: OnceLock::new() },
+    // Russian; `ru`, `ru-RU`, `ru_RU.UTF-8` and other regions resolve here. The overlay's export holds upstream's rows plus ours.
+    LangInfo {
+        code: "ru",
+        name: "Русский",
+        source: if crate::office_overlay::CATALOG_RU.is_empty() { include_str!("ru.tsv") } else { crate::office_overlay::CATALOG_RU },
+        prefer_hans: false,
+        editing_lang: None,
+        catalog: OnceLock::new(),
+    },
     LangInfo {
         code: "tr",
         name: "Türkçe",
diff --git a/crates/ui-egui/src/office_overlay_tests.rs b/crates/ui-egui/src/office_overlay_tests.rs
index 307bfe4d..af1cbafd 100644
--- a/crates/ui-egui/src/office_overlay_tests.rs
+++ b/crates/ui-egui/src/office_overlay_tests.rs
@@ -110,3 +110,26 @@ fn uzbek_is_offered_only_with_the_overlay_catalogs() {
         assert!(Lang::from_code("uz-latn").is_none());
     }
 }
+
+#[test]
+fn russian_gets_our_rows_and_keeps_upstreams() {
+    use crate::i18n::{Lang, tr};
+    let ru = Lang::from_code("ru").expect("ru");
+    if o::CATALOG_RU.is_empty() {
+        assert_eq!(tr(ru, "Transliterate"), "Transliterate");
+        return;
+    }
+    assert_eq!(tr(ru, "Transliterate"), "Транслитерация");
+    assert_eq!(tr(ru, "Latin to Cyrillic"), "С латиницы на кириллицу");
+    // Upstream's own Russian wins: every plain, escape-free row of its file reads back unchanged.
+    let mut checked = 0;
+    for line in include_str!("i18n/ru.tsv").lines().filter(|l| !l.starts_with('#') && !l.contains("\\")) {
+        if let [context, source, translation] = line.split('\t').collect::<Vec<_>>()[..] {
+            if context.is_empty() {
+                assert_eq!(tr(ru, source), o::rebrand(translation), "{source}");
+                checked += 1;
+            }
+        }
+    }
+    assert!(checked > 1000, "{checked} upstream rows checked");
+}
