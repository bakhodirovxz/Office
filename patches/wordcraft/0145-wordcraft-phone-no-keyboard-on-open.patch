From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Tue, 3 Nov 2026 12:00:00 +0500
Subject: [PATCH] ui-egui: a document that has just opened in the phone layout
 waits for a tap before it takes the keyboard

Phase 6 (docs/phase6/phone-layout.md section 9, owner decision 2026-11-03: every document opens in edit mode on a phone). The page's `want_focus` starts true and a replacing document may set it again, which would give the canvas focus (and IME output, so possibly the soft keyboard) before the user touched anything. `phone_chrome` remembers the document id it last saw (`Session::document_id`) and, on a change, drops `want_focus` and the canvas focus as it does for reading; the first tap on the page takes the focus. Desktop and a build without the extension are unchanged.
---
 crates/ui-egui/src/office_overlay.rs | 5 ++++-
 1 file changed, 4 insertions(+), 1 deletion(-)

diff --git a/crates/ui-egui/src/office_overlay.rs b/crates/ui-egui/src/office_overlay.rs
index 2450946..1c011f3 100644
--- a/crates/ui-egui/src/office_overlay.rs
+++ b/crates/ui-egui/src/office_overlay.rs
@@ -217,7 +217,10 @@ pub fn phone_chrome(app: &mut crate::WordApp, ui: &mut egui::Ui) -> bool {
     let ctx = ui.ctx().clone();
     let read = reading(&ctx);
     PHONE_READING.store(read, std::sync::atomic::Ordering::Relaxed);
-    if read {
+    // A document that has just opened (or replaced the open one) waits for the user's tap before it takes the keyboard (wordcraft/0145).
+    static PHONE_DOC: std::sync::atomic::AtomicU64 = std::sync::atomic::AtomicU64::new(u64::MAX);
+    let fresh = PHONE_DOC.swap(app.session.document_id(), std::sync::atomic::Ordering::Relaxed) != app.session.document_id();
+    if read || fresh {
         app.canvas.want_focus = false;
         app.canvas.focused = false;
         if let Some((id, _)) = app.canvas.widget_id {
