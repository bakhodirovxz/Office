From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Tue, 24 Nov 2026 12:00:00 +0500
Subject: [PATCH] wordcraft: Cargo.lock without zopfli (with 0922)

zip 9's deflate feature = deflate-zopfli + deflate-flate2-zlib-rs. Nothing sets a compression level above flate2's, so the zopfli encoder is dead weight (-77 KB brotli in the Slides wasm). deflate-flate2-zlib-rs keeps reading and writing deflate with the same zlib-rs backend.
---
 Cargo.lock | 13 -------------
 1 file changed, 13 deletions(-)

diff --git a/Cargo.lock b/Cargo.lock
index 90670d60..4a9736d6 100644
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -5998,7 +5998,6 @@ dependencies = [
  "typed-path",
  "windows-sys 0.60.2",
  "zeroize",
- "zopfli",
 ]
 
 [[package]]
@@ -6013,18 +6012,6 @@ version = "1.0.23"
 source = "registry+https://github.com/rust-lang/crates.io-index"
 checksum = "29666d0abbfad1e3dc4dcf6144730dd3a3ab225bbbdac83319345b1b44ccfc1b"
 
-[[package]]
-name = "zopfli"
-version = "0.8.3"
-source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "f05cd8797d63865425ff89b5c4a48804f35ba0ce8d125800027ad6017d2b5249"
-dependencies = [
- "bumpalo",
- "crc32fast",
- "log",
- "simd-adler32",
-]
-
 [[package]]
 name = "zune-core"
 version = "0.5.3"
