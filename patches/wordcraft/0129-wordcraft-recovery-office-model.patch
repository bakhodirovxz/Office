+        store.scan().unwrap();
+        let left: Vec<String> = store.inventory().into_iter().map(|d| d.id).collect();
+        assert_eq!(left, [unseen]);
+        assert!(!t.0.join(&seen).exists(), "the expired record's folder is gone");
+    }
