From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Fri, 6 Nov 2026 12:00:00 +0500
Subject: [PATCH] ui-egui: no empty (dark) frame while the first fonts activate

WordApp::ui drew nothing for its first two frames while the fonts installed by `logic` activated (named font families
would panic before then). eframe presents such a frame with its default clear colour, near-black (12, 12, 12), and shows
the window after the first one: the window opened dark until the third frame, the first that lays out the page
(owner, Phase 4 MSI test: "the screen goes dark and comes back"; 2.1-2.7 s on the Intel UHD 630 test PC under load).
The gate is now one pass that calls `request_discard`, so egui redoes it at once with the fonts active and the first
presented frame paints the interface. tests/no_blank_frames.rs: every frame from the first paints the interface.
---

diff --git a/crates/ui-egui/src/lib.rs b/crates/ui-egui/src/lib.rs
index 73d8a2e..4c6f099 100644
--- a/crates/ui-egui/src/lib.rs
+++ b/crates/ui-egui/src/lib.rs
@@ -2229,9 +2229,13 @@ impl WordApp {
             let opts = ctx.options(|o| o.input_options);
             ctx.input_mut(|i| i.smooth_scroll_delta = scroll::unsmoothed_scroll(i, &opts));
         }
-        // Fonts installed by `logic` take effect on the next frame.
-        if self.fonts_frames < 2 {
+        // Fonts installed by `logic` take effect on the next pass.
+        // office overlay (patches/wordcraft/0140): one empty pass, redone at once with the fonts active, instead of two
+        // presented empty frames, which showed eframe's near-black clear colour while the first page laid out (the window
+        // opened dark).
+        if self.fonts_frames < 1 {
             self.fonts_frames += 1;
+            ctx.request_discard("fonts pending");
             ctx.request_repaint();
             return;
         }
diff --git a/crates/ui-egui/tests/no_blank_frames.rs b/crates/ui-egui/tests/no_blank_frames.rs
new file mode 100644
index 0000000..b8acd90
--- /dev/null
+++ b/crates/ui-egui/tests/no_blank_frames.rs
@@ -0,0 +1,29 @@
+//! office overlay (patches/wordcraft/0140): the frame the window opens with paints the interface. While the first fonts
+//! activate, `WordApp::ui` draws nothing and asks egui to redo the pass; it used to present two empty frames, which show
+//! eframe's near-black clear colour until the first page was laid out (owner, Phase 4 MSI test: the window goes dark).
+
+use wordcraft_engine::Session;
+use wordcraft_ui_egui::{Services, WordApp};
+
+/// An empty frame has no shapes; the interface is hundreds.
+const EMPTY: usize = 10;
+
+#[test]
+fn the_first_frames_paint_the_interface() {
+    // eframe's frames, from the very first one (a kittest harness runs frames before a test sees them).
+    let ctx = egui::Context::default();
+    let mut app = WordApp::new(Session::new(wordcraft_doc::Document::from_text("one\ntwo")), Services::default());
+    for frame in 0..3 {
+        let input = egui::RawInput {
+            screen_rect: Some(egui::Rect::from_min_size(egui::Pos2::ZERO, egui::vec2(1440.0, 900.0))),
+            time: Some(f64::from(frame) / 60.0),
+            ..Default::default()
+        };
+        let mut out = ctx.run_ui(input, |ui| {
+            app.logic(ui.ctx());
+            app.ui(ui);
+        });
+        out.textures_delta.clear(); // no renderer here
+        assert!(out.shapes.len() > EMPTY, "frame {frame}: {} shapes, the window would show the clear colour", out.shapes.len());
+    }
+}
