From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Sun, 22 Nov 2026 12:00:00 +0500
Subject: [PATCH] engine: Cyrillic to Latin with nothing selected upgrades 1995 Latin, an English-looking text keeps it

tools.translitLatn on the whole sheet, workbook, slide or deck sets uz-translit Options.latin_upgrade and
upgrade_skip_english (as the MS Office add-in does): 1995 Latin becomes 2026 Latin, a cell or paragraph with 2+ English
function words keeps its Latin, Cyrillic in it is still converted. A real selection is unchanged (Latin-dominant only).
---
diff --git a/crates/engine/src/cmd/translit.rs b/crates/engine/src/cmd/translit.rs
index 232633e3..fc26a496 100644
--- a/crates/engine/src/cmd/translit.rs
+++ b/crates/engine/src/cmd/translit.rs
@@ -263,8 +263,10 @@ fn run(s: &mut Session, p: &Value, dir: Option<Direction>) -> Result<Value> {
     } else {
         None
     };
-    // Cyrillic to Latin on a Latin-dominant selection (never the slide or deck) rewrites 1995 Latin in the 2026 letters.
-    opts.latin_upgrade = upgradable && detected == Some(Script::Latin);
+    // Cyrillic to Latin rewrites 1995 Latin in the 2026 letters: on a Latin-dominant selection, and on a whole slide or deck
+    // too, where a paragraph that looks English keeps its Latin.
+    opts.latin_upgrade = dir == Some(Direction::ToLatin) && (!selection || detected == Some(Script::Latin));
+    opts.upgrade_skip_english = !selection;
     let dir = dir.or_else(|| detected.map(|sc| if sc == Script::Latin { Direction::ToCyrillic } else { Direction::ToLatin }));
     let mut changed: Vec<(usize, Slide)> = Vec::new();
     if dir.is_some() {
diff --git a/crates/engine/tests/translit.rs b/crates/engine/tests/translit.rs
index fa99cac7..19d0037b 100644
--- a/crates/engine/tests/translit.rs
+++ b/crates/engine/tests/translit.rs
@@ -326,7 +326,20 @@ fn cyrillic_to_latin_on_a_latin_selection_upgrades_1995_latin_only_there() {
     s.execute(LATN, &json!({})).unwrap();
     // a segment that already has a 2026 letter stays; the unselected shape is untouched
     assert_eq!((text_of(&s, 0, a), text_of(&s, 0, b), text_of(&s, 0, c)), ("Şahar".into(), "Ishoq şahar".into(), "Shahar".into()));
-    // the slide scope is never upgraded
+}
+
+#[test]
+fn cyrillic_to_latin_on_the_whole_slide_upgrades_1995_latin_but_not_an_english_paragraph() {
+    let mut s = session();
+    let a = add(&mut s, "Shahar");
+    let b = add(&mut s, "This is the best fish");
+    let c = add(&mut s, "Шаҳар");
+    let d = add(&mut s, "This is the Шаҳар");
+    deselect(&mut s);
     s.execute(LATN, &json!({"scope": "slide"})).unwrap();
-    assert_eq!(text_of(&s, 0, c), "Shahar");
+    // Uzbek 1995 Latin is upgraded, the English paragraph is untouched, Cyrillic is converted, also inside the English one
+    assert_eq!(
+        [text_of(&s, 0, a), text_of(&s, 0, b), text_of(&s, 0, c), text_of(&s, 0, d)],
+        ["Şahar", "This is the best fish", "Şahar", "This is the Şahar"]
+    );
 }
