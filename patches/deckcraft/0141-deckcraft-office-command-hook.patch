@@ -579,7 +580,16 @@ impl Session {
     /// Run command `id`. A panic inside it becomes [`EngineError::Internal`] and leaves the
     /// presentation as it was.
     pub fn execute(&mut self, id: &str, params: &Value) -> Result<Value> {
-        self.guarded(id, |s| s.execute_unguarded(id, params))
+        if self.depth == 0
+            && let Some(why) = office_hook::refusal(id, self)
+        {
+            return Err(EngineError::Disabled(id.into(), why));
+        }
+        let result = self.guarded(id, |s| s.execute_unguarded(id, params));
+        if self.depth == 0 {
+            office_hook::after(id, self, params, &result);
+        }
+        result
     }
 
     fn execute_unguarded(&mut self, id: &str, params: &Value) -> Result<Value> {
diff --git a/crates/engine/src/office_hook.rs b/crates/engine/src/office_hook.rs
new file mode 100644
index 0000000..b6e54fe
--- /dev/null
+++ b/crates/engine/src/office_hook.rs
@@ -0,0 +1,49 @@
+// Added by the office command-hook patch. MIT OR Apache-2.0.
+//! The command-hook seam (PLAN phase 4 section 4): a policy (XDFU restrictions, the snapshot after a save, Phase 5 permissions)
+//! attaches here and sees every command a user action runs. Nothing is attached by default, and then `Session::execute`
+//! behaves exactly as upstream's does.
+//!
+//! Only the outermost command of an action is offered to the hook: commands that run other commands (`depth > 0`) are one
+//! action, so a policy sees `file.export`, not the steps inside it.
+
+use std::sync::{Arc, RwLock};
+
+use serde_json::Value;
+
+use crate::{Result, Session};
+
+/// What a policy can do.
+pub trait CommandHook: Send + Sync {
+    /// A reason to refuse `id`, or `None` to allow it. Asked before the command runs, and by the UI to grey a control out.
+    /// `id` may also be a UI-level name that is no registry command (`file.print`, for the PDF a print opens).
+    fn before(&self, id: &str, s: &Session) -> Option<String> {
+        let _ = (id, s);
+        None
+    }
+    /// The outcome of command `id` once it ran (a failed one too).
+    fn after(&self, id: &str, s: &Session, params: &Value, result: &Result<Value>) {
+        let _ = (id, s, params, result);
+    }
+}
+
+static HOOK: RwLock<Option<Arc<dyn CommandHook>>> = RwLock::new(None);
+
+/// Attach a policy hook, or with `None` remove it.
+pub fn set_hook(hook: Option<Arc<dyn CommandHook>>) {
+    *HOOK.write().unwrap_or_else(|e| e.into_inner()) = hook;
+}
+
+fn hook() -> Option<Arc<dyn CommandHook>> {
+    HOOK.read().unwrap_or_else(|e| e.into_inner()).clone()
+}
+
+/// Why the hook refuses `id` right now (`None`: allowed, or no hook).
+pub fn refusal(id: &str, s: &Session) -> Option<String> {
+    hook()?.before(id, s)
+}
+
+pub(crate) fn after(id: &str, s: &Session, params: &Value, result: &Result<Value>) {
+    if let Some(h) = hook() {
+        h.after(id, s, params, result);
+    }
+}
diff --git a/crates/engine/tests/office_hook.rs b/crates/engine/tests/office_hook.rs
new file mode 100644
index 0000000..774f9f0
--- /dev/null
+++ b/crates/engine/tests/office_hook.rs
@@ -0,0 +1,81 @@
+// Added by the office command-hook patch. MIT OR Apache-2.0.
+//! The command-hook seam: a refusing hook stops a command, the after-hook sees a save, and with no hook (or one that allows
+//! everything) a command's result is byte-identical. The hook is process-wide, so the tests take turns.
+#![allow(clippy::unwrap_used, clippy::expect_used)]
+
+use std::sync::{Arc, Mutex};
+
+use deckcraft_engine::office_hook::{self, CommandHook};
+use deckcraft_engine::{Result, Session};
+use serde_json::{Value, json};
+
+static TURN: Mutex<()> = Mutex::new(());
+
+struct Recorder {
+    refuse: &'static [&'static str],
+    seen: Mutex<Vec<(String, bool)>>,
+}
+
+impl CommandHook for Recorder {
+    fn before(&self, id: &str, _: &Session) -> Option<String> {
+        self.refuse.contains(&id).then(|| "refused by policy".to_string())
+    }
+    fn after(&self, id: &str, _: &Session, _: &Value, result: &Result<Value>) {
+        self.seen.lock().unwrap().push((id.to_string(), result.is_ok()));
+    }
+}
+
+fn recorder(refuse: &'static [&'static str]) -> Arc<Recorder> {
+    Arc::new(Recorder { refuse, seen: Mutex::default() })
+}
+
+fn temp(name: &str) -> String {
+    std::env::temp_dir().join(format!("deckcraft-hook-{}-{name}", std::process::id())).to_string_lossy().to_string()
+}
+
+#[test]
+fn hook_refuses_print() {
+    let _turn = TURN.lock().unwrap_or_else(|e| e.into_inner());
+    let hook = recorder(&["file.export"]);
+    office_hook::set_hook(Some(hook.clone()));
+    let mut s = Session::with_new();
+    let path = temp("print.pdf");
+    let err = s.execute("file.export", &json!({"path": path, "format": "pdf"})).unwrap_err();
+    assert!(err.to_string().contains("refused by policy"), "{err}");
+    assert!(!std::path::Path::new(&path).exists(), "the refused export wrote a file");
+    assert_eq!(office_hook::refusal("file.export", &s).as_deref(), Some("refused by policy"));
+    // Other commands run, and the hook saw them.
+    s.execute("slide.new", &json!({})).unwrap();
+    assert!(hook.seen.lock().unwrap().iter().any(|(id, ok)| id == "slide.new" && *ok));
+    office_hook::set_hook(None);
+    assert!(office_hook::refusal("file.export", &s).is_none());
+    let _ = std::fs::remove_file(path);
+}
+
+#[test]
+fn hook_sees_save() {
+    let _turn = TURN.lock().unwrap_or_else(|e| e.into_inner());
+    let hook = recorder(&[]);
+    office_hook::set_hook(Some(hook.clone()));
+    let mut s = Session::with_new();
+    let path = temp("save.pptx");
+    s.execute("file.save", &json!({"path": path})).unwrap();
+    office_hook::set_hook(None);
+    assert!(hook.seen.lock().unwrap().iter().any(|(id, ok)| id == "file.save" && *ok), "{:?}", hook.seen.lock().unwrap());
+    assert!(std::path::Path::new(&path).exists());
+    let _ = std::fs::remove_file(path);
+}
+
+#[test]
+fn without_a_hook_nothing_changes() {
+    let _turn = TURN.lock().unwrap_or_else(|e| e.into_inner());
+    let bytes = |s: &mut Session| s.execute("file.saveBytes", &json!({"format": "pptx"})).unwrap();
+    let mut s = Session::with_new();
+    s.execute("insert.textBox", &json!({"text": "Salom"})).ok();
+    office_hook::set_hook(None);
+    let plain = bytes(&mut s);
+    office_hook::set_hook(Some(recorder(&[])));
+    let hooked = bytes(&mut s);
+    office_hook::set_hook(None);
+    assert_eq!(plain, hooked);
+}
