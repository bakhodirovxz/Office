+/// A boolean field, `default` when absent or not a boolean.
+fn flag(data: &JsValue, key: &str, default: bool) -> bool {
+    js_sys::Reflect::get(data, &JsValue::from_str(key)).ok().and_then(|v| v.as_bool()).unwrap_or(default)
+}
