From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Sat, 21 Nov 2026 12:00:00 +0500
Subject: [PATCH] engine: Cyrillic to Latin on a Latin selection rewrites 1995 Latin in the 2026 letters

tools.translitLatn (a text range or selected shapes, Latin-dominant) sets uz-translit Options.latin_upgrade, so 1995 Latin
words become 2026 Latin; a segment that already has a 2026 letter stays. The slide and deck scopes never upgrade; `visit`
now takes the options as a parameter. Test: cyrillic_to_latin_on_a_latin_selection_upgrades_1995_latin_only_there.
---
diff --git a/crates/engine/src/cmd/translit.rs b/crates/engine/src/cmd/translit.rs
index 497de54a..232633e3 100644
--- a/crates/engine/src/cmd/translit.rs
+++ b/crates/engine/src/cmd/translit.rs
@@ -216,7 +216,7 @@ fn run(s: &mut Session, p: &Value, dir: Option<Direction>) -> Result<Value> {
         Some(o) => return Err(bad(id, format!("`latinAlphabet` must be 1995, 2026 or auto, not `{o}`"))),
     };
     let defaults = Options::default();
-    let opts = Options { apostrophe, latin_alphabet, foreign_latin_guard: bool_or(p, "foreignGuard", defaults.foreign_latin_guard), ..defaults };
+    let mut opts = Options { apostrophe, latin_alphabet, foreign_latin_guard: bool_or(p, "foreignGuard", defaults.foreign_latin_guard), ..defaults };
 
     let t0 = now_ms();
     let st = s.doc()?;
@@ -244,27 +244,34 @@ fn run(s: &mut Session, p: &Value, dir: Option<Direction>) -> Result<Value> {
         Scope::Shapes(v) => (Some(v.as_slice()), false, None),
         _ => (None, true, None),
     };
-    let visit = |sl: &mut Slide, dir: Option<Direction>, stats: &mut Stats, sink: &mut String| {
+    let visit = |sl: &mut Slide, dir: Option<Direction>, opts: &Options, stats: &mut Stats, sink: &mut String| {
         walk(sl, only, notes, &mut |loc, t| match range {
-            Some((l, a, b)) if l == loc => body(t, Some((a, b)), dir, &opts, stats, sink),
+            Some((l, a, b)) if l == loc => body(t, Some((a, b)), dir, opts, stats, sink),
             Some(_) => {}
-            None => body(t, None, dir, &opts, stats, sink),
+            None => body(t, None, dir, opts, stats, sink),
         });
     };
     let mut stats = Stats::default();
-    let dir = dir.or_else(|| {
+    let selection = matches!(scope, Scope::Range(..) | Scope::Shapes(_));
+    let upgradable = selection && dir == Some(Direction::ToLatin);
+    let detected = if dir.is_none() || upgradable {
         let mut text = String::new();
         for &i in &slides {
-            visit(&mut (*doc.slides[i]).clone(), None, &mut Stats::default(), &mut text);
+            visit(&mut (*doc.slides[i]).clone(), None, &opts, &mut Stats::default(), &mut text);
         }
-        uz_translit::detect(&text).map(|sc| if sc == Script::Latin { Direction::ToCyrillic } else { Direction::ToLatin })
-    });
+        uz_translit::detect(&text)
+    } else {
+        None
+    };
+    // Cyrillic to Latin on a Latin-dominant selection (never the slide or deck) rewrites 1995 Latin in the 2026 letters.
+    opts.latin_upgrade = upgradable && detected == Some(Script::Latin);
+    let dir = dir.or_else(|| detected.map(|sc| if sc == Script::Latin { Direction::ToCyrillic } else { Direction::ToLatin }));
     let mut changed: Vec<(usize, Slide)> = Vec::new();
     if dir.is_some() {
         for &i in &slides {
             let mut sl = (*doc.slides[i]).clone();
             let before = stats.paragraphs;
-            visit(&mut sl, dir, &mut stats, &mut String::new());
+            visit(&mut sl, dir, &opts, &mut stats, &mut String::new());
             if stats.paragraphs > before {
                 changed.push((i, sl));
             }
diff --git a/crates/engine/tests/translit.rs b/crates/engine/tests/translit.rs
index 313aa114..fa99cac7 100644
--- a/crates/engine/tests/translit.rs
+++ b/crates/engine/tests/translit.rs
@@ -311,3 +311,22 @@ fn without_the_param_the_latin_alphabet_is_the_suite_default_2026() {
     s.execute(LATN, &json!({})).unwrap();
     assert_eq!(text_of(&s, 0, a), "Şahar öğil");
 }
+
+#[test]
+fn cyrillic_to_latin_on_a_latin_selection_upgrades_1995_latin_only_there() {
+    let mut s = session();
+    let a = add(&mut s, "Shahar");
+    let b = add(&mut s, "Ishoq şahar");
+    let c = add(&mut s, "Shahar");
+    s.select(|_, sel| {
+        sel.shapes = vec![a, b];
+        sel.text = None;
+    })
+    .unwrap();
+    s.execute(LATN, &json!({})).unwrap();
+    // a segment that already has a 2026 letter stays; the unselected shape is untouched
+    assert_eq!((text_of(&s, 0, a), text_of(&s, 0, b), text_of(&s, 0, c)), ("Şahar".into(), "Ishoq şahar".into(), "Shahar".into()));
+    // the slide scope is never upgraded
+    s.execute(LATN, &json!({"scope": "slide"})).unwrap();
+    assert_eq!(text_of(&s, 0, c), "Shahar");
+}
