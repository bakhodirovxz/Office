From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Sat, 24 Oct 2026 18:00:00 +0500
Subject: [PATCH] ui-egui: the shared lang setting picks the language when the app's own is auto

Gate review (brief task 5, owner 2026-10-24): office_overlay::shared_lang_code reads the shared lang; i18n::from_pref resolves auto to it (English without one, as before).
---
diff --git a/crates/ui-egui/src/i18n.rs b/crates/ui-egui/src/i18n.rs
index 9b394c5..39d713b 100644
--- a/crates/ui-egui/src/i18n.rs
+++ b/crates/ui-egui/src/i18n.rs
@@ -155,7 +155,9 @@ impl Lang {
 
 /// Resolve the `language` setting: a language code, or [`AUTO`] (and anything unknown or not built in) for English.
 pub fn from_pref(pref: &str) -> Lang {
-    Lang::from_tag(pref).unwrap_or(Lang::EN)
+    // office overlay (patches/deckcraft/0145): `auto` follows the shared `lang` setting (English without one).
+    let shared = || crate::office_overlay::shared_lang_code().and_then(Lang::from_tag);
+    Lang::from_tag(pref).or_else(|| pref.eq_ignore_ascii_case(AUTO).then(shared).flatten()).unwrap_or(Lang::EN)
 }
 
 /// The canonical `language` setting for user input: [`AUTO`] or a registered code. `None` for anything else, so the caller keeps the setting.
diff --git a/crates/ui-egui/src/office_overlay.rs b/crates/ui-egui/src/office_overlay.rs
index 38a2cc3..7fafba8 100644
--- a/crates/ui-egui/src/office_overlay.rs
+++ b/crates/ui-egui/src/office_overlay.rs
@@ -195,3 +195,29 @@ fn use_shared_dictionaries() {
         }
     }
 }
+
+/// The shared `lang` setting (`settings.toml`, PLAN 5.1) as this app's language code (`en`, `ru`, `uz-latn`, `uz-cyrl`), read once.
+/// `None` for `auto`, with no file, in the web build and in tests: the app keeps its own detection there. `uz-Latn-2026` has no
+/// catalog in the apps yet (STATUS, deferred) and shows the `uz-latn` one.
+#[cfg(not(any(target_arch = "wasm32", test)))]
+pub fn shared_lang_code() -> Option<&'static str> {
+    static CODE: std::sync::OnceLock<Option<&'static str>> = std::sync::OnceLock::new();
+    *CODE.get_or_init(|| code_of(suite_core::settings::load().lang))
+}
+
+#[cfg(any(target_arch = "wasm32", test))]
+pub fn shared_lang_code() -> Option<&'static str> {
+    None
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) fn code_of(choice: suite_core::lang::LangChoice) -> Option<&'static str> {
+    use suite_core::lang::{Lang, LangChoice};
+    match choice {
+        LangChoice::Auto => None,
+        LangChoice::Fixed(Lang::En) => Some("en"),
+        LangChoice::Fixed(Lang::Ru) => Some("ru"),
+        LangChoice::Fixed(Lang::UzLatn | Lang::UzLatn2026) => Some("uz-latn"),
+        LangChoice::Fixed(Lang::UzCyrl) => Some("uz-cyrl"),
+    }
+}
diff --git a/crates/ui-egui/src/office_overlay_tests.rs b/crates/ui-egui/src/office_overlay_tests.rs
index 19c179e..b44b704 100644
--- a/crates/ui-egui/src/office_overlay_tests.rs
+++ b/crates/ui-egui/src/office_overlay_tests.rs
@@ -189,3 +189,21 @@ fn shared_dictionary_folders_come_in_order() {
     assert!(o::dictionary_dirs("  ", None).is_empty());
     let _ = std::fs::remove_dir_all(root);
 }
+
+/// The shared `lang` setting reaches the app's catalog language (patches/deckcraft/0145): `auto` leaves the app's own choice, a fixed
+/// language maps to the code the app registers.
+#[test]
+fn shared_lang_picks_the_catalog_language() {
+    use suite_core::lang::{Lang as S, LangChoice::{Auto, Fixed}};
+    assert_eq!(o::code_of(Auto), None);
+    assert_eq!(o::shared_lang_code(), None, "tests never read the user's settings");
+    for (choice, code) in [(Fixed(S::En), "en"), (Fixed(S::Ru), "ru"), (Fixed(S::UzLatn), "uz-latn"), (Fixed(S::UzLatn2026), "uz-latn"), (Fixed(S::UzCyrl), "uz-cyrl")] {
+        assert_eq!(o::code_of(choice), Some(code));
+        let l = crate::i18n::from_pref(code);
+        if l != crate::i18n::Lang::EN {
+            assert_eq!(l.code(), code);
+        } else {
+            assert!(code == "en" || (code == "ru" && !cfg!(office_ru)) || (code.starts_with("uz") && !cfg!(office_uz)), "{code} must be registered");
+        }
+    }
+}
