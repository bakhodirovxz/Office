From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Sat, 24 Oct 2026 18:00:00 +0500
Subject: [PATCH] ui-egui: a fixed shared lang setting wins over the saved
 language at start

Gate review (brief task 5, owner 2026-10-24): office_overlay::shared_lang_code reads the shared lang once (suite-core, native only; None for auto, no file, the web and tests). main.rs applies office_overlay::start_language after load_prefs: a fixed shared lang always wins over the saved language, auto keeps it; an in-app change holds for the session and is not written back.
---
 apps/deckcraft/src/main.rs                 |  2 ++
 crates/ui-egui/src/office_overlay.rs       | 36 ++++++++++++++++++++++
 crates/ui-egui/src/office_overlay_tests.rs | 33 ++++++++++++++++++++
 3 files changed, 71 insertions(+)

diff --git a/apps/deckcraft/src/main.rs b/apps/deckcraft/src/main.rs
index 732559b..b79c2ce 100644
--- a/apps/deckcraft/src/main.rs
+++ b/apps/deckcraft/src/main.rs
@@ -254,6 +254,8 @@ fn main() -> eframe::Result {
         Box::new(move |cc| {
             let mut app = SlideApp::new(Session::new(), services());
             load_prefs(&mut app);
+            // office overlay (patches/deckcraft/0145): a fixed shared `lang` wins over the saved language at each start.
+            app.ui.language = deckcraft_ui_egui::office_overlay::start_language(&app.ui.language);
             // AutoRecover: reopen what a previous run left unsaved, then keep it current.
             if std::env::var_os("DECKCRAFT_NO_RECOVERY").is_none() {
                 app.session.recovery_dir = deckcraft_engine::recovery::default_dir();
diff --git a/crates/ui-egui/src/office_overlay.rs b/crates/ui-egui/src/office_overlay.rs
index 38a2cc3..43af098 100644
--- a/crates/ui-egui/src/office_overlay.rs
+++ b/crates/ui-egui/src/office_overlay.rs
@@ -195,3 +195,39 @@ fn use_shared_dictionaries() {
         }
     }
 }
+
+/// The shared `lang` setting (`settings.toml`, PLAN 5.1) as this app's language code (`en`, `ru`, `uz-latn`, `uz-cyrl`), read once.
+/// `None` for `auto`, with no file, in the web build and in tests: the app keeps its own detection there. `uz-Latn-2026` has no
+/// catalog in the apps yet (STATUS, deferred) and shows the `uz-latn` one.
+#[cfg(not(any(target_arch = "wasm32", test)))]
+pub fn shared_lang_code() -> Option<&'static str> {
+    static CODE: std::sync::OnceLock<Option<&'static str>> = std::sync::OnceLock::new();
+    *CODE.get_or_init(|| code_of(suite_core::settings::load().lang))
+}
+
+#[cfg(any(target_arch = "wasm32", test))]
+pub fn shared_lang_code() -> Option<&'static str> {
+    None
+}
+
+/// The `language` setting at start: a fixed shared `lang` always wins over the app's saved one, `auto` (`None`) keeps it. A change
+/// made in the app afterwards holds for the session only; the shell is the one writer of `settings.toml`.
+pub fn start_language(own: &str) -> String {
+    language_at_start(own, shared_lang_code())
+}
+
+pub(crate) fn language_at_start(own: &str, shared: Option<&str>) -> String {
+    shared.and_then(crate::i18n::normalize_pref).map_or_else(|| own.to_string(), str::to_string)
+}
+
+#[cfg(not(target_arch = "wasm32"))]
+pub(crate) fn code_of(choice: suite_core::lang::LangChoice) -> Option<&'static str> {
+    use suite_core::lang::{Lang, LangChoice};
+    match choice {
+        LangChoice::Auto => None,
+        LangChoice::Fixed(Lang::En) => Some("en"),
+        LangChoice::Fixed(Lang::Ru) => Some("ru"),
+        LangChoice::Fixed(Lang::UzLatn | Lang::UzLatn2026) => Some("uz-latn"),
+        LangChoice::Fixed(Lang::UzCyrl) => Some("uz-cyrl"),
+    }
+}
diff --git a/crates/ui-egui/src/office_overlay_tests.rs b/crates/ui-egui/src/office_overlay_tests.rs
index 19c179e..23ec915 100644
--- a/crates/ui-egui/src/office_overlay_tests.rs
+++ b/crates/ui-egui/src/office_overlay_tests.rs
@@ -189,3 +189,36 @@ fn shared_dictionary_folders_come_in_order() {
     assert!(o::dictionary_dirs("  ", None).is_empty());
     let _ = std::fs::remove_dir_all(root);
 }
+
+/// A fixed shared `lang` beats the saved language (also a fixed one); `auto` and a language the app does not register keep it.
+#[test]
+fn shared_lang_wins_over_the_saved_language_at_start() {
+    assert_eq!(o::language_at_start("auto", Some("en")), "en");
+    assert_eq!(o::language_at_start("de", Some("en")), "en");
+    assert_eq!(o::language_at_start("de", None), "de");
+    assert_eq!(o::language_at_start("auto", None), "auto");
+    assert_eq!(o::language_at_start("de", Some("xx")), "de");
+}
+
+/// The shared `lang` setting reaches the app's catalog language (patches/deckcraft/0145): `auto` leaves the app's own choice, a fixed
+/// language maps to the code the app registers.
+#[test]
+fn shared_lang_picks_the_catalog_language() {
+    use suite_core::lang::{
+        Lang as S,
+        LangChoice::{Auto, Fixed},
+    };
+    assert_eq!(o::code_of(Auto), None);
+    assert_eq!(o::shared_lang_code(), None, "tests never read the user's settings");
+    for (choice, code) in
+        [(Fixed(S::En), "en"), (Fixed(S::Ru), "ru"), (Fixed(S::UzLatn), "uz-latn"), (Fixed(S::UzLatn2026), "uz-latn"), (Fixed(S::UzCyrl), "uz-cyrl")]
+    {
+        assert_eq!(o::code_of(choice), Some(code));
+        let l = crate::i18n::from_pref(code);
+        if l != crate::i18n::Lang::EN {
+            assert_eq!(l.code(), code);
+        } else {
+            assert!(code == "en" || (code == "ru" && !cfg!(office_ru)) || (code.starts_with("uz") && !cfg!(office_uz)), "{code} must be registered");
+        }
+    }
+}
