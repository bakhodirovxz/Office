From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Tue, 20 Oct 2026 23:15:49 +0500
Subject: [PATCH] ui-egui: office overlay adds a Russian language when its
 catalog is present
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

deckcraft has no upstream Russian, so `ru` joins the registry only when the overlay supplies a catalog-ru.tsv
(`cargo xt i18n export`, our rows). build_office.rs reads it, sets cfg(office_ru) and embeds it; LANGUAGES grows by
one entry and the picker lists Русский. Without the file the language list is upstream's.
---
 crates/ui-egui/build_office.rs             | 19 +++++++++++++++++--
 crates/ui-egui/src/i18n.rs                 |  7 +++++--
 crates/ui-egui/src/office_overlay_tests.rs | 14 ++++++++++++++
 3 files changed, 36 insertions(+), 4 deletions(-)

diff --git a/crates/ui-egui/build_office.rs b/crates/ui-egui/build_office.rs
index 86d43ae..d0ba66b 100644
--- a/crates/ui-egui/build_office.rs
+++ b/crates/ui-egui/build_office.rs
@@ -102,7 +102,7 @@ fn generate(dir: &Path) -> String {
         let _ = write!(list, "({key:?}, include_bytes!({:?}) as &[u8]), ", include_path(dir, f));
     }
     let _ = writeln!(o, "pub static FALLBACK_FONTS: &[(&str, &[u8])] = &[{list}];");
-    o + &uzbek(Some(dir))
+    o + &uzbek(Some(dir)) + &russian(Some(dir))
 }
 
 /// The Uzbek catalogs that `cargo xt i18n export` wrote next to `overlay.env`. Only when both are there does the build
@@ -135,6 +135,21 @@ fn uzbek(dir: Option<&Path>) -> String {
     o
 }
 
+/// The Russian catalog that `cargo xt i18n export` wrote next to `overlay.env` (only our rows: deckcraft has no upstream Russian).
+/// With it the build gets `cfg(office_ru)`, which adds `ru` to the language registry.
+fn russian(dir: Option<&Path>) -> String {
+    println!("cargo::rustc-check-cfg=cfg(office_ru)");
+    let Some(file) = dir.map(|d| d.join("catalog-ru.tsv")).filter(|f| f.is_file()) else {
+        return "pub const RU_LANGS: usize = 0;\npub const CATALOG_RU: &str = \"\";\n".into();
+    };
+    println!("cargo::rustc-cfg=office_ru");
+    println!("cargo::rerun-if-changed={}", file.display());
+    format!(
+        "pub const RU_LANGS: usize = 1;\npub const CATALOG_RU: &str = include_str!({:?});\n",
+        file.to_string_lossy().replace(std::path::MAIN_SEPARATOR, "/")
+    )
+}
+
 fn generate_upstream() -> String {
     let mut o = String::from("// GENERATED by build_office.rs (no overlay: upstream values). Do not edit.\n");
     let _ = writeln!(o, "pub const ACTIVE: bool = false;");
@@ -154,5 +169,5 @@ fn generate_upstream() -> String {
     let _ = writeln!(o, "pub static LOGO_RGBA: Option<&[u8]> = None;");
     let _ = writeln!(o, "pub const LOGO_SIZE: usize = 128;");
     let _ = writeln!(o, "pub static FALLBACK_FONTS: &[(&str, &[u8])] = &[];");
-    o + &uzbek(None)
+    o + &uzbek(None) + &russian(None)
 }
diff --git a/crates/ui-egui/src/i18n.rs b/crates/ui-egui/src/i18n.rs
index 562289e..9b394c5 100644
--- a/crates/ui-egui/src/i18n.rs
+++ b/crates/ui-egui/src/i18n.rs
@@ -24,13 +24,16 @@ pub struct LangInfo {
     catalog: OnceLock<HashMap<String, String>>,
 }
 
-/// The registry. English first: it is the fallback and the source language. Uzbek is there only when the overlay supplies its catalogs.
-pub static LANGUAGES: [LangInfo; 1 + crate::office_overlay::EXTRA_LANGS] = [
+/// The registry. English first: it is the fallback and the source language. Uzbek and Russian are there only when the overlay supplies
+/// their catalogs.
+pub static LANGUAGES: [LangInfo; 1 + crate::office_overlay::EXTRA_LANGS + crate::office_overlay::RU_LANGS] = [
     LangInfo { code: "en", name: "English", source: "", catalog: OnceLock::new() },
     #[cfg(office_uz)]
     LangInfo { code: "uz-latn", name: crate::office_overlay::NAME_UZ_LATN, source: crate::office_overlay::CATALOG_UZ_LATN, catalog: OnceLock::new() },
     #[cfg(office_uz)]
     LangInfo { code: "uz-cyrl", name: crate::office_overlay::NAME_UZ_CYRL, source: crate::office_overlay::CATALOG_UZ_CYRL, catalog: OnceLock::new() },
+    #[cfg(office_ru)]
+    LangInfo { code: "ru", name: "Русский", source: crate::office_overlay::CATALOG_RU, catalog: OnceLock::new() },
 ];
 
 impl LangInfo {
diff --git a/crates/ui-egui/src/office_overlay_tests.rs b/crates/ui-egui/src/office_overlay_tests.rs
index a54a88a..97a9dbb 100644
--- a/crates/ui-egui/src/office_overlay_tests.rs
+++ b/crates/ui-egui/src/office_overlay_tests.rs
@@ -161,3 +161,17 @@ fn cyrillic_is_not_laid_out_in_the_cjk_face() {
     let mut o = ctx.run_ui(Default::default(), |_| {});
     o.textures_delta.clear();
 }
+
+#[test]
+fn russian_is_offered_only_with_the_overlay_catalog() {
+    use crate::i18n::{Lang, from_pref, tr};
+    if cfg!(office_ru) {
+        let ru = from_pref("ru");
+        assert_eq!((ru.code(), ru.name()), ("ru", "Русский"));
+        assert_eq!(tr(ru, "Transliterate"), "Транслитерация");
+        assert_eq!(tr(ru, "Latin to Cyrillic"), "С латиницы на кириллицу");
+        assert_eq!(tr(ru, "A string no catalog has"), "A string no catalog has");
+    } else {
+        assert!(Lang::from_tag("ru").is_none());
+    }
+}
