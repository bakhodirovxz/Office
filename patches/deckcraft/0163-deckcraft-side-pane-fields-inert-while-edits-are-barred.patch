From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Sun, 8 Nov 2026 12:00:00 +0500
Subject: [PATCH] deckcraft: a policy that bars edits also keeps the side panes' fields and the number boxes inert, and the reply box stops widening the Comments pane

A read-only session refused every command, but the fields of the side panes still took typed text, so the text showed for as long as the
field kept focus. While SlideApp::locked() (the command hook refuses office_hook::EDIT) the Format Shape, Format Background, Animation and
SmartArt Text panes are drawn disabled as a whole (alt text, sizes, line width, SmartArt lines), the Comments reply box, the Selection
pane's shape rename and the sorter's section rename are not interactive, and widgets::spinner (every number box of the ribbon and the panes)
reads the same state from a context flag SlideApp::ui sets each frame. With no hook nothing changes.
The reply box was sized as available_width - 70, but the Resolve and Delete buttons that follow it need about 100, so the row overflowed and the
resizable pane grew a little on every repaint until it reached its maximum, which moved the slide under a test or a reader; it now leaves 120.
Test: ci/web-smoke/bridge-slides.spec.ts case 11 (outline view, comment reply, Format Shape pane, text box tool), each against an editable control.
---

diff --git a/crates/ui-egui/src/lib.rs b/crates/ui-egui/src/lib.rs
index 2e80576..0e716c1 100644
--- a/crates/ui-egui/src/lib.rs
+++ b/crates/ui-egui/src/lib.rs
@@ -1877,6 +1877,7 @@ impl SlideApp {
             return;
         }
         i18n::set_current(i18n::from_pref(&self.ui.language));
+        ctx.data_mut(|d| d.insert_temp(egui::Id::new("edits-barred"), self.locked()));
         let t0 = now_ms();
         let t = theme::Tokens::get(&ctx);
         self.tick_media(&ctx);
diff --git a/crates/ui-egui/src/panes.rs b/crates/ui-egui/src/panes.rs
index 9dd4df8..1096c6d 100644
--- a/crates/ui-egui/src/panes.rs
+++ b/crates/ui-egui/src/panes.rs
@@ -47,17 +47,21 @@ pub fn show(app: &mut SlideApp, ui: &mut Ui) {
                 });
             });
             ui.add_space(6.0);
-            egui::ScrollArea::vertical().auto_shrink([false, false]).show(ui, |ui| match pane.as_str() {
-                "format" => format_shape(app, ui),
-                "background" => background(app, ui),
-                "animation" => animation(app, ui),
-                "selection" => crate::selpane::show(app, ui),
-                "comments" => comments(app, ui),
-                "designer" => designer(app, ui),
-                "smartart" => smartart(app, ui),
-                "thesaurus" => thesaurus(app, ui),
-                "revisions" => revisions(app, ui),
-                _ => {}
+            // A policy that bars edits: the panes that only edit (alt text, SmartArt lines, sizes) are shown but inert, so nothing typed appears.
+            let inert = app.locked() && matches!(pane.as_str(), "format" | "background" | "animation" | "smartart");
+            egui::ScrollArea::vertical().auto_shrink([false, false]).show(ui, |ui| {
+                ui.add_enabled_ui(!inert, |ui| match pane.as_str() {
+                    "format" => format_shape(app, ui),
+                    "background" => background(app, ui),
+                    "animation" => animation(app, ui),
+                    "selection" => crate::selpane::show(app, ui),
+                    "comments" => comments(app, ui),
+                    "designer" => designer(app, ui),
+                    "smartart" => smartart(app, ui),
+                    "thesaurus" => thesaurus(app, ui),
+                    "revisions" => revisions(app, ui),
+                    _ => {}
+                });
             });
         });
 }
