From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: office <office@localhost>
Date: Tue, 3 Nov 2026 12:00:00 +0500
Subject: [PATCH] deckcraft-web: don't ask the GPU for more texture size than it offers

egui-wgpu's default device descriptor requires max_texture_dimension_2d = 8192. A WebGL2 context that reports less (4096 in the
Android emulator's Chrome, and on some phones) makes requestDevice fail, so the app shows "Limit 'max_texture_dimension_2d'
value 8192 is better than allowed 4096" and never starts. Wrap egui-wgpu's descriptor and lower the requested size to what the
adapter reports, keeping every other limit as egui-wgpu sets it (same change as wordcraft/0002).
---

diff --git a/apps/deckcraft-web/src/web.rs b/apps/deckcraft-web/src/web.rs
index 22a4470..0feb2e0 100644
--- a/apps/deckcraft-web/src/web.rs
+++ b/apps/deckcraft-web/src/web.rs
@@ -29,6 +29,17 @@ pub fn start() {
         {
             create.instance_descriptor.backends = eframe::wgpu::Backends::GL;
         }
+        // egui-wgpu requires 8192 texels per side, which WebGL2 contexts that report 4096
+        // (Android emulators, some phones) refuse: ask for what the adapter offers, up to that.
+        if let eframe::egui_wgpu::WgpuSetup::CreateNew(create) = &mut options.wgpu_options.wgpu_setup {
+            let egui_descriptor = create.device_descriptor.clone();
+            create.device_descriptor = std::sync::Arc::new(move |adapter| {
+                let mut descriptor = egui_descriptor(adapter);
+                let offered = adapter.limits().max_texture_dimension_2d;
+                descriptor.required_limits.max_texture_dimension_2d = descriptor.required_limits.max_texture_dimension_2d.min(offered);
+                descriptor
+            });
+        }
         // `?host=parent`: a page framing DeckCraft (the web shell) opens presentations in it and
         // stores what it saves (`host`).
         let bridge = if query_param("host").as_deref() == Some("parent") { host::Bridge::new(query_param("parent_origin")) } else { None };
