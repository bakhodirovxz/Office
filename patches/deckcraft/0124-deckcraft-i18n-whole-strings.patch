 crates/ui-egui/src/lib.rs     | 23 ++++++++++++++++++++-
 crates/ui-egui/src/ribbon.rs  | 14 +++++++++----
 crates/ui-egui/src/toast.rs   | 30 ++++++++++++++++++++-------
 4 files changed, 74 insertions(+), 31 deletions(-)

