diff --git a/apps/deckcraft-web/src/web.rs b/apps/deckcraft-web/src/web.rs
index 0feb2e0..cf4d5b1 100644
--- a/apps/deckcraft-web/src/web.rs
+++ b/apps/deckcraft-web/src/web.rs
@@ -76,6 +76,11 @@ pub fn start() {
                         app.start_show(0, false);
                     }
                     if let Some(bridge) = &app_bridge {
+                        // Phase 7 WP13 (patches/deckcraft/0158): plugins from the host page (slides-plugins), before `ready` asks for them
+                        #[cfg(feature = "office-ext")]
