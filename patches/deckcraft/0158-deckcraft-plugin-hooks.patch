index 1befaad..532f27c 100644
--- a/crates/ui-egui/src/office_overlay.rs
+++ b/crates/ui-egui/src/office_overlay.rs
@@ -280,3 +280,19 @@ pub(crate) fn brightness_at_start(own: crate::theme::Brightness, shared: Option<
         _ => own,
     }
 }
+
+/// The plugin commands of the domain's extension crate (Phase 7 WP13, patch deckcraft/0158): per plugin its name and its commands as
+/// (label, registry id), in the interface language. Set once at start-up by the apps behind `office-ext` (slides-plugins); without it
+/// the toolbar has no Plugins menu.
+pub type PluginMenu = fn(&str) -> Vec<(String, Vec<(String, &'static str)>)>;
+
+static PLUGIN_MENU: std::sync::OnceLock<PluginMenu> = std::sync::OnceLock::new();
+
+pub fn set_plugin_menu(menu: PluginMenu) {
+    let _ = PLUGIN_MENU.set(menu);
+}
+
+/// The Plugins menu in the current interface language (empty without plugins).
+pub fn plugin_menu() -> Vec<(String, Vec<(String, &'static str)>)> {
+    PLUGIN_MENU.get().map(|f| f(crate::i18n::current().code())).unwrap_or_default()
+}
diff --git a/crates/ui-egui/src/office_toolbar.rs b/crates/ui-egui/src/office_toolbar.rs
index 772f971..972b860 100644
--- a/crates/ui-egui/src/office_toolbar.rs
+++ b/crates/ui-egui/src/office_toolbar.rs
@@ -442,6 +442,35 @@ fn output_group(app: &mut SlideApp, ui: &mut Ui, labels: bool) {
     {
         f(app);
     }
+    plugins_menu(app, ui);
+}
+
+/// The plugin commands (Phase 7 WP13): a menu per plugin, hidden while none is loaded. It has no icon of its own, so its label
+/// always shows. A finished command's status (the plugin's `ui.status`) goes to the status bar; on the web a command answers
+/// `{pending}` at once and the page shows the outcome.
+fn plugins_menu(app: &mut SlideApp, ui: &mut Ui) {
+    let menu = office_overlay::plugin_menu();
+    if menu.is_empty() {
+        return;
+    }
+    let label = crate::i18n::t("Plugins");
+    let main = button(ui, Btn::new("", label).tip(label.to_string()).menu(), true).0;
+    egui::Popup::menu(&main).show(|ui| {
+        for (plugin, commands) in menu {
+            ui.menu_button(plugin, |ui| {
+                for (label, id) in commands {
+                    if ui.button(label).clicked() {
+                        if let Ok(v) = app.run(id, json!({}))
+                            && let Some(t) = v.get("status").and_then(Value::as_str)
+                        {
+                            app.set_status(t.to_string());
+                        }
+                        ui.close();
+                    }
+                }
+            });
+        }
+    });
 }
 
