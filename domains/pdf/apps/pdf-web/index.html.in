<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{APP_NAME}}</title>
  <script>
    /* The web shell passes ?lang=; the editor reads its language from navigator.language(s), so answer with the shell's. */
    (() => { const l = new URLSearchParams(location.search).get('lang'); if (!l) return;
      try { Object.defineProperty(navigator, 'language', { get: () => l, configurable: true }); Object.defineProperty(navigator, 'languages', { get: () => [l], configurable: true }); } catch (_) { /* keep the browser's */ } })();
  </script>
    <link data-trunk rel="icon" href="{{FAVICON}}" />
    <link data-trunk rel="rust" data-wasm-opt="z" />
    <style>
      html, body { margin: 0; height: 100%; overflow: hidden; background: #f1f1f3; }
      canvas { width: 100%; height: 100%; display: block; outline: none; }
      @media (prefers-color-scheme: dark) { html, body { background: #19191c; } }
    </style>
  </head>
  <body>
    <canvas id="pdfcraft"></canvas>
  </body>
</html>
