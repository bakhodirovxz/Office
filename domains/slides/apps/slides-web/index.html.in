<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
  <title>{{APP_NAME}}</title>
  <script>
    /* The web shell passes ?lang=; the editor reads its language from navigator.language(s), so answer with the shell's. */
    (() => { const l = new URLSearchParams(location.search).get('lang'); if (!l) return;
      try { Object.defineProperty(navigator, 'language', { get: () => l, configurable: true }); Object.defineProperty(navigator, 'languages', { get: () => [l], configurable: true }); } catch (_) { /* keep the browser's */ } })();
  </script>
  <link data-trunk rel="rust" data-bin="slides-web" data-wasm-opt="z" data-weak-refs />
  <link data-trunk rel="icon" href="{{FAVICON}}" />
  <style>
    html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #262626; }
    #deckcraft_canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
    #deckcraft_loading { position: absolute; inset: 0; display: flex; flex-direction: column; align-items: center; justify-content: center;
      color: #b8b8b8; font: 14px system-ui, sans-serif; pointer-events: none; }
  </style>
</head>
<body>
  <canvas id="deckcraft_canvas"></canvas>
  <div id="deckcraft_loading">Loading {{APP_NAME}}&hellip;</div>
</body>
</html>
