+/// The cells of one row: (column, cell), sorted by column, columns unique. Never empty in a
+/// store. Serialized as a map from column to cell (as it was when rows were maps).
+#[derive(Clone, Debug, Default, PartialEq)]
+struct Row(Vec<(u32, Cell)>);
+
+impl Serialize for Row {
+    fn serialize<S: Serializer>(&self, s: S) -> Result<S::Ok, S::Error> {
+        s.collect_map(self.0.iter().map(|(c, cell)| (c, cell)))
+    }
+}
+
+impl<'de> Deserialize<'de> for Row {
+    fn deserialize<D: Deserializer<'de>>(d: D) -> Result<Row, D::Error> {
+        Ok(Row(BTreeMap::<u32, Cell>::deserialize(d)?.into_iter().collect()))
+    }
+}
+
+impl Row {
+    fn find(&self, col: u32) -> Result<usize, usize> {
+        self.0.binary_search_by_key(&col, |(c, _)| *c)
+    }
+    fn get(&self, col: u32) -> Option<&Cell> {
+        self.find(col).ok().and_then(|i| self.0.get(i)).map(|(_, cell)| cell)
+    }
+    fn get_mut(&mut self, col: u32) -> Option<&mut Cell> {
+        let i = self.find(col).ok()?;
+        self.0.get_mut(i).map(|(_, cell)| cell)
+    }
+    fn contains(&self, col: u32) -> bool {
+        self.find(col).is_ok()
+    }
+    /// Stores `cell` at `col`, returning the cell it replaces.
+    fn insert(&mut self, col: u32, cell: Cell) -> Option<Cell> {
+        match self.find(col) {
+            Ok(i) => self.0.get_mut(i).map(|slot| std::mem::replace(&mut slot.1, cell)),
+            Err(i) => {
+                // Grows by half (not double) its length: a row filled cell by cell, as a reader
+                // fills it, ends close to its size.
+                if self.0.len() == self.0.capacity() {
+                    self.0.reserve_exact((self.0.len() / 2).max(2));
+                }
+                self.0.insert(i, (col, cell));
+                None
+            }
+        }
+    }
+    fn remove(&mut self, col: u32) -> Option<Cell> {
+        let i = self.find(col).ok()?;
+        Some(self.0.remove(i).1)
+    }
+    /// Index range of the columns `c0..=c1`.
+    fn span(&self, c0: u32, c1: u32) -> std::ops::Range<usize> {
+        let a = self.0.partition_point(|(c, _)| *c < c0);
+        let b = self.0.partition_point(|(c, _)| *c <= c1).max(a);
+        a..b
+    }
+    fn range(&self, c0: u32, c1: u32) -> impl Iterator<Item = (u32, &Cell)> + '_ {
+        self.0.get(self.span(c0, c1)).unwrap_or_default().iter().map(|(c, cell)| (*c, cell))
+    }
+    fn iter(&self) -> impl DoubleEndedIterator<Item = (u32, &Cell)> + '_ {
+        self.0.iter().map(|(c, cell)| (*c, cell))
+    }
+    fn is_empty(&self) -> bool {
+        self.0.is_empty()
+    }
+    fn len(&self) -> usize {
+        self.0.len()
+    }
 }
 
