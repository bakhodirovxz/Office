+/// A formula of a recalculation pass: its tree, or a shifted copy of a shared tree, whose own tree
+/// is built only while it is evaluated (a pass over a run of formulas then holds one tree, not one
+/// per cell).
+#[derive(Clone, Debug)]
+enum PassExpr {
+    Tree(std::sync::Arc<Expr>),
+    Shifted(std::sync::Arc<Formula>),
+}
+
+impl PassExpr {
+    fn of(f: &std::sync::Arc<Formula>) -> Option<PassExpr> {
+        match f.template() {
+            Some((_, dr, dc)) if (dr, dc) != (0, 0) => Some(PassExpr::Shifted(f.clone())),
+            _ => f.expr_arc().map(PassExpr::Tree),
+        }
+    }
+    fn tree(&self) -> Option<std::sync::Arc<Expr>> {
+        match self {
+            PassExpr::Tree(e) => Some(e.clone()),
+            PassExpr::Shifted(f) => f.expr_arc(),
+        }
+    }
+}
+
+impl From<std::sync::Arc<Expr>> for PassExpr {
+    fn from(e: std::sync::Arc<Expr>) -> Self {
+        PassExpr::Tree(e)
+    }
+}
+
 struct PassHost<'a> {
