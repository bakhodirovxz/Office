+
+impl PartialEq for Formula {
+    fn eq(&self, other: &Self) -> bool {
+        if self.array != other.array {
+            return false;
+        }
+        match (&self.repr, &other.repr) {
+            (Repr::Shifted { base: a, dr: r1, dc: c1 }, Repr::Shifted { base: b, dr: r2, dc: c2 }) if Arc::ptr_eq(a, b) => r1 == r2 && c1 == c2,
