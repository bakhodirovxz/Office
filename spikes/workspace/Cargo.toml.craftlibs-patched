# SPIKE (Phase 0): one virtual workspace over the four upstream Craft apps. Generated by gen_workspace.py + hand edits for [patch].
[workspace]
resolver = "3"
members = [
  "src/wordcraft/crates/*",
  "src/wordcraft/apps/*",
  "src/gridcraft/crates/*",
  "src/gridcraft/apps/*",
  "src/deckcraft/crates/*",
  "src/deckcraft/apps/*",
  "src/pdfcraft/crates/*",
  "src/pdfcraft/apps/*",
]
exclude = ["src/pdfcraft/vendor", "src/craft-libs"]

[workspace.package]
# CONFLICT: version 0.7.0 (word/grid/deck) vs 0.8.0 (pdfcraft; its crates require `version = "0.8.0"` on path deps) -> 0.8.0
version = "0.8.0"
edition = "2024"
license = "MIT OR Apache-2.0"
# CONFLICT: 1.90 (word/grid) vs 1.95 (deck/pdf) -> 1.95
rust-version = "1.95"
# CONFLICT: repository differs per app (storytold/<app>); one value only
repository = "https://github.com/storytold/craft-apps"

[workspace.dependencies]
wordcraft-geom = { path = "src/wordcraft/crates/geom" }
wordcraft-doc = { path = "src/wordcraft/crates/doc" }
