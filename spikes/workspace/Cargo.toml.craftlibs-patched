# UNION of the four [workspace.lints]; loosens pdfcraft (no clippy allows upstream) -- see report.
[workspace.lints.rust]
unsafe_code = "forbid"

[workspace.lints.clippy]
dbg_macro = "warn"
todo = "warn"
too_many_arguments = "allow"
type_complexity = "allow"
self_named_constructors = "allow"
large_enum_variant = "allow"
result_large_err = "allow"

# Profiles: only the root's count. word/grid/deck: codegen-units 16, debug 0; pdfcraft: codegen-units 1.
[profile.dev.package."*"]
opt-level = 2
debug = "line-tables-only"

[profile.dev]
opt-level = 1

[profile.low-disk]
inherits = "dev"
debug = "line-tables-only"
incremental = false

[profile.release]
opt-level = 3
lto = "thin"
codegen-units = 16
debug = 0

# [patch] is honoured only at the workspace root, so the four apps share one set.
# pdfcraft's vendored forks (hayro*, lopdf, winit, egui-wgpu, vello_common) now apply to ALL apps.
[patch.crates-io]
hayro-interpret = { path = "src/pdfcraft/vendor/hayro-interpret" }
hayro = { path = "src/pdfcraft/vendor/hayro" }
hayro-syntax = { path = "src/pdfcraft/vendor/hayro-syntax" }
hayro-jbig2 = { path = "src/pdfcraft/vendor/hayro-jbig2" }
lopdf = { path = "src/pdfcraft/vendor/lopdf" }
winit = { path = "src/pdfcraft/vendor/winit" }
egui-wgpu = { path = "src/pdfcraft/vendor/egui-wgpu" }
vello_common = { path = "src/pdfcraft/vendor/vello_common" }
# deckcraft patched krilla to craft-libs git; craft-libs itself patches it to its vendor/krilla.
krilla = { path = "src/craft-libs/vendor/krilla" }

# VARIANT: redirect every craft-libs git rev to one local checkout (single copy of craft-ui/print/quit/pdf)
[patch."https://github.com/storytold/craft-libs"]
craft-ui = { path = "../../upstream/craft-libs/crates/ui" }
craft-print = { path = "../../upstream/craft-libs/crates/print" }
craft-quit = { path = "../../upstream/craft-libs/crates/quit" }
craft-pdf = { path = "../../upstream/craft-libs/crates/pdf" }
