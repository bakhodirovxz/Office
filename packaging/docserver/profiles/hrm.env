# install.sh profile (example): an HR backend that embeds an ONLYOFFICE Document Server, as surveyed in
# docs/phase0/hrm-current-state.md section 4 (the defaults are the backend's own, P:188, P:414). KEY=value, no quotes; the last wins.
# The image of the container to replace (a prefix of `docker ps`'s image column)
FROM_IMAGE=onlyoffice/documentserver
# Our provider name (audit log)
PROVIDER=hrm
# The backend's document and callback base URL: the env name on the backend container, and its default
BACKEND_URL_ENV=BACKEND_SELF_URL
BACKEND_URL_DEFAULT=http://api:8000
# Where the backend sends the saved-file download (it rewrites the callback url's host to this)
REWRITE_ENV=BACKEND_DOCS_URL
REWRITE_DEFAULT=http://docs-server
# The backend's allowlist of callback url hosts (host names, comma list) and its default
ALLOWED_HOSTS_ENV=BACKEND_CALLBACK_HOSTS
ALLOWED_HOSTS_DEFAULT=docs-server,docs-alias,minio
# The backend's env names of the shared secret, in the order it reads them
SECRET_ENVS=BACKEND_DOCS_SECRET JWT_SECRET
# Backend env names that list the origins of its web pages (a CORS list or the SPA's own URL); empty: give --frame-origin. On the
# test server (2026-11-08) FRONTEND_URL is the SPA origin that embeds the editor.
ORIGIN_ENVS=FRONTEND_URL
# The editors' language (--ui-lang): the backend always sends editorConfig.lang "ru" (ONLYOFFICE has no Uzbek), its own UI is Uzbek
UI_LANG=uz-Latn
